{
  "name": "fairspec",
  "main": "./worker.ts",
  "preview_urls": true,
  "compatibility_date": "2025-08-15",
  "assets": {
    "directory": "./.livemark/build/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "fairspec.org", "custom_domain": true },
    { "pattern": "python.fairspec.org", "custom_domain": true },
    { "pattern": "typescript.fairspec.org", "custom_domain": true },
    { "pattern": "application.fairspec.org", "custom_domain": true },
  ],
}
