{
  "$schema": "https://fairspec.org/profiles/latest/dataset.json",
  "doi": "10.1234/example.dataset.2024",
  "creators": [
    {
      "name": "Jane Smith",
      "nameType": "Personal",
      "givenName": "Jane",
      "familyName": "Smith"
    },
    {
      "name": "Research Institute of Data Science",
      "nameType": "Organizational"
    }
  ],
  "titles": [
    {
      "title": "Experimental Measurements of Chemical Reactions Dataset"
    }
  ],
  "publisher": {
    "name": "Fairspec Research Repository"
  },
  "publicationYear": "2024",
  "types": {
    "resourceTypeGeneral": "Dataset"
  },
  "descriptions": [
    {
      "description": "This dataset contains experimental measurements from chemical reaction studies including spectroscopy data, reaction parameters, and analytical results.",
      "descriptionType": "Abstract"
    }
  ],
  "resources": [
    {
      "name": "measurements",
      "data": "measurements.csv",
      "integrity": {
        "type": "sha256",
        "hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      },
      "fileDialect": {
        "format": "csv",
        "delimiter": ",",
        "lineTerminator": "\n",
        "quoteChar": "\"",
        "nullSequence": "NA",
        "headerRows": [1, 2],
        "headerJoin": "_",
        "commentPrefix": "#"
      },
      "tableSchema": {
        "required": ["experiment_id"],
        "primaryKey": ["experiment_id"],
        "properties": {
          "experiment_id": {
            "type": "integer"
          },
          "temperature_celsius": {
            "type": "number"
          },
          "concentration_mol": {
            "type": ["number", "null"]
          }
        }
      },
      "titles": [
        {
          "title": "Primary Experimental Measurements"
        }
      ],
      "descriptions": [
        {
          "description": "Main data file containing all experimental measurements with two header rows: the parameter, then its unit.",
          "descriptionType": "Other"
        }
      ]
    },
    {
      "name": "spectroscopy",
      "data": "spectroscopy.json",
      "fileDialect": {
        "format": "json",
        "jsonPointer": "/data/spectra",
        "rowType": "object"
      },
      "tableSchema": {
        "properties": {
          "wavelength": {
            "type": "number"
          },
          "intensity": {
            "type": "number"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "titles": [
        {
          "title": "Spectroscopy Data"
        }
      ]
    },
    {
      "name": "reactions",
      "data": "reactions.xlsx",
      "fileDialect": {
        "format": "xlsx",
        "sheetName": "Results",
        "headerRows": [1],
        "commentRows": [2, 3]
      },
      "titles": [
        {
          "title": "Reaction Parameters and Results"
        }
      ]
    },
    {
      "name": "analysis",
      "data": "analysis.sqlite",
      "fileDialect": {
        "format": "sqlite",
        "tableName": "statistical_analysis"
      },
      "titles": [
        {
          "title": "Statistical Analysis Results"
        }
      ]
    },
    {
      "name": "supplementary",
      "data": [
        "https://example.com/data/part1.csv",
        "https://example.com/data/part2.csv"
      ],
      "fileDialect": {
        "format": "csv",
        "delimiter": ";",
        "headerRows": false,
        "columnNames": ["sample_id", "value", "uncertainty", "notes"]
      },
      "titles": [
        {
          "title": "Supplementary Measurements (Multi-part)"
        }
      ]
    },
    {
      "name": "controls",
      "data": {
        "samples": [
          {
            "id": 1,
            "name": "Control Sample",
            "result": "positive"
          },
          {
            "id": 2,
            "name": "Test Sample A",
            "result": "negative"
          }
        ]
      },
      "dataSchema": {
        "type": "object",
        "required": ["samples"],
        "properties": {
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "result"],
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "result": { "enum": ["positive", "negative"] }
              }
            }
          }
        }
      },
      "titles": [
        {
          "title": "Inline Control Samples Data"
        }
      ]
    }
  ]
}
