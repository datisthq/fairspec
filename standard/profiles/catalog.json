{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/Catalog"
    }
  ],
  "$defs": {
    "Catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Dataset"
      }
    },
    "Dataset": {
      "type": "object",
      "required": ["loc", "upd"],
      "properties": {
        "loc": {
          "$ref": "#/$defs/Location"
        },
        "upd": {
          "$ref": "#/$defs/Updated"
        },
        "del": {
          "type": "boolean"
        }
      }
    },
    "Location": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://"
    },
    "Updated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
