  {
    "description": "Preview the raw source of a local or remote file as UTF-8 text: the first lines exactly as stored, before any parsing. Use it to see a CSV's delimiter, header and quoting, or a JSON file's structure. Stops at `maxLines` or `maxBytes`, whichever comes first; `truncated` is true when the file continues.",
    "inputSchema": {
      "properties": {
        "path": {
          "description": "Local or remote path of the file",
          "title": "Path",
          "type": "string"
        },
        "maxLines": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum number of lines (default 20)",
          "title": "Maxlines"
        },
        "maxBytes": {
          "anyOf": [
            {
              "maximum": 20000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum number of bytes (default 10000)",
          "title": "Maxbytes"
        }
      },
      "required": ["path"],
      "type": "object",
      "title": "preview_file_toolArguments"
    },
    "name": "previewFileTool",
    "outputSchema": {
      "properties": {
        "text": {
          "description": "The raw file source",
          "title": "Text",
          "type": "string"
        },
        "truncated": {
          "description": "Whether the file continues past the preview",
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": ["text", "truncated"],
      "type": "object",
      "title": "PreviewFileResult"
    }
  },
