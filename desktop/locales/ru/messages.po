#: routes/data/index.tsx
msgid "Automatically derive a comprehensive JSON Schema definition from your data's structure and values"
msgstr "Автоматически получать полное определение JSON Schema на основе структуры и значений ваших данных"

#: routes/data/infer-schema.tsx
msgid "Automatically infer comprehensive data schemas from your datasets"
msgstr "Автоматически определяйте комплексные схемы данных из ваших наборов данных"

#: routes/table/index.tsx
#: routes/table/infer-schema.tsx
msgid "Automatically infer comprehensive table schema definitions with column types and constraints from your tabular data"
msgstr "Автоматически выводите полные определения схем таблиц с типами столбцов и ограничениями из ваших табличных данных"

#: routes/dataset/index.tsx
#: routes/dataset/infer.tsx
msgid "Automatically infer dataset metadata, table resources, and the overall structure from your raw data files"
msgstr "Автоматически выводите метаданные набора данных, ресурсы таблиц и общую структуру из ваших сырых файлов данных"

#: routes/file/infer-dialect.tsx
msgid "Automatically infer file formats, encoding specifications, and dialect parameters"
msgstr "Автоматически определяйте форматы файлов, спецификации кодировки и параметры диалекта"

#: helpers/help.ts
msgid "Bring a JSON data file and the data schema it is supposed to satisfy"
msgstr "Подготовьте файл данных JSON и схему данных, которой он должен соответствовать"

#: helpers/help.ts
msgid "Bring a table schema to check against, or infer one first if you do not have it yet"
msgstr "Подготовьте схему таблицы для проверки или сначала выведите её, если её ещё нет"

#: helpers/help.ts
msgid "Builds a dataset descriptor from a tabular file, inferring the resource, its schema and its dialect"
msgstr "Создаёт дескриптор набора данных из табличного файла, выводя ресурс, его схему и диалект"

