    "@fairspec/metadata": "0.12.1",
    "@lingui/babel-plugin-lingui-macro": "6.1.0",
    "@lingui/cli": "6.1.0",
    "@lingui/core": "6.1.0",
    "@lingui/detect-locale": "6.1.0",
    "@lingui/format-po": "6.1.0",
    "@lingui/macro": "5.9.5",
    "@lingui/react": "6.1.0",
    "@lingui/vite-plugin": "6.1.0",
    "@orpc/client": "1.14.3",
