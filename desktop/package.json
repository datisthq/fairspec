    "es-toolkit": "1.44.0",
    "lefthook": "2.1.1",
    "livemark": "0.20.0",
    "lucide-react": "0.555.0",
    "next-themes": "^0.4.6",
    "npm-check-updates": "23.1.0",
    "react": "19.0.0",
