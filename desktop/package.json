    "vaul": "^1.1.2",
    "vite": "catalog:",
    "vite-plugin-svgr": "5.2.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.90.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
