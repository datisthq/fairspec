    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "catalog:",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.4",
    "electron": "42.2.0",
    "electron-builder": "26.8.1",
