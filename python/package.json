{
  "name": "@fairspec/python",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "uv build --all-packages --out-dir build",
    "check:types": "uv run ty check",
    "format": "uv run ruff format",
    "lint": "uv run ruff check",
    "release": "uv publish build/*",
    "setup": "uv sync --all-packages",
    "show:coverage": "sensible-browser htmlcov/index.html",
    "test": "pnpm check:types && pnpm test:unit",
    "test:unit": "uv run pytest --cov --cov-report html --cov-report json"
  }
}
