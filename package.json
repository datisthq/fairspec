{
  "name": "fairspec-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typescript build && pnpm desktop build && pnpm python build",
    "build:site": "livemark build",
    "catalog": "pnpm -F ./catalog run",
    "deps": "ncu -ws --root -u --cooldown 7d",
    "desktop": "pnpm -F ./desktop run",
    "format": "vp fmt --no-error-on-unmatched-pattern && pnpm python format",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "lint": "vp fmt --check && vp lint && pnpm python lint",
    "prepare": "lefthook install && mkdir -p .claude && ln -sfn ../.agents/skills .claude/skills && (command -v uv >/dev/null && pnpm python setup || true)",
    "preview:site": "livemark preview",
    "python": "pnpm -F ./python run",
    "scan": "pnpm leaks && pnpm vulns",
    "standard": "pnpm -F ./standard run",
    "start:site": "livemark start",
    "test": "pnpm lint && vp test && pnpm standard test && pnpm typescript test && pnpm desktop test && pnpm python test",
    "type": "tsgo --noEmit && pnpm standard type && pnpm typescript type && pnpm desktop type && pnpm python type",
    "typescript": "pnpm -F ./typescript run",
    "unit": "vp test && pnpm standard unit && pnpm typescript unit && pnpm desktop unit && pnpm python unit",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/python --config=p/owasp-top-ten --config=p/secrets --exclude='**/fixtures/**' --metrics=off"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "0.4.5",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "cn": "catalog:",
    "lefthook": "2.1.1",
    "livemark": "0.25.0",
    "lucide-react": "catalog:",
    "npm-check-updates": "23.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.90.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
