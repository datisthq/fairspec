{
  "name": "fairspec",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "livemark build",
    "deps": "ncu -u",
    "format": "vp fmt",
    "generate": "node @generate.ts",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install",
    "preview": "livemark preview",
    "scan": "pnpm leaks && pnpm vulns",
    "vers": "pnpm version --no-git-tag-version",
    "start": "livemark start",
    "test": "pnpm lint && pnpm type",
    "type": "tsgo --noEmit",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --metrics=off"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "0.4.4",
    "@semantic-release/exec": "7.1.0",
    "@tanstack/react-router": "1.168.1",
    "@tanstack/react-start": "1.167.2",
    "@types/node": "25.6.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260507.1",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "execa": "9.6.1",
    "lefthook": "2.1.1",
    "livemark": "^0.20.0",
    "lucide-react": "^0.577.0",
    "npm-check-updates": "18.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "replace-in-file": "8.4.0",
    "semantic-release": "24.2.9",
    "tasuku": "2.0.5",
    "vite-plus": "0.1.24",
    "wrangler": "4.90.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
