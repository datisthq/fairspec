{
  "name": "@fairspec/typescript",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "deps": "ncu -ws -u --cooldown 7d",
    "coverage": "sensible-browser coverage/index.html",
    "debug": "vp test --no-file-parallelism --test-timeout=0 --inspect-brk --browser run",
    "docs:build": "livemark build",
    "docs:start": "livemark start",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install && mkdir -p .claude && ln -sfn ../.agents/skills .claude/skills",
    "preview": "livemark preview",
    "release": "pnpm -r publish --access public --ignore-scripts --no-git-checks",
    "scan": "pnpm leaks && pnpm vulns",
    "unit": "vp test",
    "test": "pnpm lint && pnpm build && pnpm unit",
    "test:win": "pnpm unit",
    "type": "pnpm -r type",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --exclude='**/fixtures/**' --metrics=off"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "0.4.5",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "@types/node": "24.2.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "@vitest/coverage-v8": "catalog:",
    "cn": "0.2.4",
    "execa": "9.6.0",
    "lefthook": "2.1.1",
    "livemark": "0.20.0",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tempy": "3.1.0",
    "type-fest": "4.41.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-polly": "2.1.0",
    "wrangler": "4.90.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
