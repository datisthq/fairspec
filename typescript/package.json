{
  "name": "@fairspec/typescript",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -F \"./*\" run build",
    "check:types": "pnpm -F \"./*\" run check:types",
    "debug": "vp test --no-file-parallelism --test-timeout=0 --inspect-brk --browser run",
    "measure:coverage": "vp test --run --coverage",
    "release": "pnpm -F \"./*\" publish --access public --ignore-scripts --no-git-checks",
    "show:coverage": "sensible-browser coverage/index.html",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "vp test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "execa": "9.6.0",
    "tempy": "catalog:",
    "type-fest": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
