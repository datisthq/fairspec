{
  "name": "@fairspec/terminal",
  "version": "0.13.2",
  "description": "Fairspec TypeScript is a fast data management framework built on top of the Fairspec standard and Polars DataFrames",
  "keywords": [
    "cli",
    "data",
    "dataframe",
    "fair",
    "fairspec",
    "jsonschema",
    "polars",
    "quality",
    "tableschema",
    "terminal",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": {
    "type": "git",
    "url": "https://github.com/datisthq/fairspec",
    "directory": "typescript/terminal"
  },
  "bin": {
    "fairspec": "./build/entrypoints/run.js"
  },
  "files": [
    "build",
    "!build/**/-test"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./build/index.js",
    "./run": "./build/entrypoints/run.js"
  },
  "scripts": {
    "build": "tsgo && pnpm build:bundle && pnpm build:copy && pnpm build:mode",
    "build:bundle": "vp pack",
    "build:copy": "cp entrypoints/*.cmd build/entrypoints && cp package.json build",
    "build:mode": "chmod +x ./build/entrypoints/*.js",
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.12",
    "@fairspec/library": "workspace:*",
    "@fairspec/mcp-server": "workspace:*",
    "calamine-node": "0.2.0",
    "commander": "^14.0.3",
    "fireargs": "^0.6.0",
    "json-colorizer": "^3.0.1",
    "nodejs-polars": "^0.26.1",
    "picocolors": "^1.1.1",
    "tasuku": "^2.0.5",
    "wasm-xlsxwriter": "0.13.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
