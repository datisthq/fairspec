{
  "name": "@fairspec/metadata",
  "version": "0.13.1",
  "description": "Fairspec TypeScript is a fast data management framework built on top of the Fairspec standard and Polars DataFrames",
  "keywords": [
    "data",
    "dataframe",
    "fair",
    "fairspec",
    "jsonschema",
    "metadata",
    "polars",
    "quality",
    "tableschema",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": {
    "type": "git",
    "url": "https://github.com/datisthq/fairspec",
    "directory": "typescript/metadata"
  },
  "files": [
    "build",
    "!build/**/-test"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./build/index.js",
    "./testing": "./build/-test/recording.js"
  },
  "scripts": {
    "build": "tsgo",
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^0.9.0",
    "@types/json-schema": "^7.0.15",
    "ajv": "^8.17.1",
    "quick-lru": "^7.0.1",
    "ts-extras": "^0.16.1",
    "undici": "^7.30.1",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@pollyjs/adapter-fetch": "6.0.6",
    "@pollyjs/core": "6.0.6",
    "@pollyjs/persister-fs": "6.0.6"
  }
}
