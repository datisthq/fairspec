{
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "packages": {
    "standard": {
      "release-type": "node",
      "component": "standard"
    },
    "desktop": {
      "release-type": "node",
      "component": "desktop"
    },
    "python": {
      "release-type": "python",
      "component": "python",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "dataset/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "fairspec/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "library/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "mcp-server/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "metadata/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "table/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "terminal/pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    },
    "typescript": {
      "release-type": "node",
      "component": "typescript",
      "extra-files": [
        {
          "type": "json",
          "path": "dataset/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "extension/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "fairspec/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "library/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "mcp-server/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "metadata/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "table/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "terminal/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "rust": {
      "release-type": "simple",
      "component": "rust",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.dependencies.*.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value === 'fairspec' || @.name.value === 'fairspec-dataset' || @.name.value === 'fairspec-library' || @.name.value === 'fairspec-mcp-server' || @.name.value === 'fairspec-metadata' || @.name.value === 'fairspec-table' || @.name.value === 'fairspec-terminal')].version"
        }
      ]
    }
  }
}
