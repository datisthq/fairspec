  {
    "description": "a short first header row above short data rows",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#csv",
      "https://fairspec.org/specs/file-dialect/#headerrows"
    ],
    "fileDialect": {
      "format": "csv",
      "headerRows": [1, 2]
    },
    "tests": [
      {
        "description": "the widest header row sets the width",
        "data": "x\na,b,c\n1,2,3\n4\n",
        "expected": {
          "columns": ["x a", "x b", "x c"],
          "rows": [
            [1, 2, 3],
            [4, null, null]
          ]
        }
      }
    ]
  }
]
