[
  {
    "description": "jsonl rows",
    "format": "jsonl",
    "tests": [
      {
        "description": "one object per line",
        "data": "{\"id\":1,\"name\":\"alice\"}\n{\"id\":2,\"name\":\"bob\"}\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, "bob"]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonl rows without a dialect, uneven lines",
    "comment": "An inferred object-row dialect is read like a declared default one",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#jsonl",
      "https://fairspec.org/specs/file-dialect/#rowtype"
    ],
    "format": "jsonl",
    "tests": [
      {
        "description": "a key missing from a line is null",
        "data": "{\"id\":1,\"name\":\"alice\"}\n{\"id\":2}\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, null]
          ]
        }
      },
      {
        "description": "a key first seen on a later line is a column",
        "data": "{\"id\":1}\n{\"id\":2,\"name\":\"bob\"}\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, null],
            [2, "bob"]
          ]
        }
      },
      {
        "description": "an explicit null is null",
        "data": "{\"id\":1,\"name\":null}\n{\"id\":2,\"name\":\"bob\"}\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, null],
            [2, "bob"]
          ]
        }
      }
    ]
  },
  {
    "description": "json array of objects",
    "format": "json",
    "tests": [
      {
        "description": "rows given as an array",
        "data": [
          {
            "id": 1,
            "name": "alice"
          },
          {
            "id": 2,
            "name": "bob"
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, "bob"]
          ]
        }
      }
    ]
  },
  {
    "description": "json array of objects, uneven rows",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#json",
      "https://fairspec.org/specs/file-dialect/#rowtype"
    ],
    "format": "json",
    "tests": [
      {
        "description": "a key missing from a row is null",
        "data": [
          {
            "id": 1,
            "name": "alice"
          },
          {
            "id": 2
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, null]
          ]
        }
      },
      {
        "description": "a key first seen on a later row is a column",
        "data": [
          {
            "id": 1
          },
          {
            "id": 2,
            "name": "bob"
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, null],
            [2, "bob"]
          ]
        }
      },
      {
        "description": "an explicit null is null",
        "data": [
          {
            "id": 1,
            "name": null
          },
          {
            "id": 2,
            "name": "bob"
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, null],
            [2, "bob"]
          ]
        }
      }
    ]
  },
  {
    "description": "json array of objects with a declared default dialect",
    "specification": ["https://fairspec.org/specs/file-dialect/#json"],
    "format": "json",
    "fileDialect": {
      "format": "json"
    },
    "tests": [
      {
        "description": "rows given as an array",
        "data": [
          {
            "id": 1,
            "name": "alice"
          },
          {
            "id": 2,
            "name": "bob"
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, "bob"]
          ]
        }
      },
      {
        "description": "whitespace before the first row",
        "data": "\n  [\n  {\"id\":1},\n  {\"id\":2}\n]\n",
        "expected": {
          "columns": ["id"],
          "rows": [[1], [2]]
        }
      }
    ]
  },
  {
    "description": "json object rows in first-seen key order",
    "specification": ["https://fairspec.org/specs/file-dialect/#rowtype"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "object"
    },
    "tests": [
      {
        "description": "a key first seen on a later row follows the earlier keys",
        "data": "[{\"b\":1},{\"a\":2,\"c\":3,\"b\":4}]",
        "expected": {
          "columns": ["b", "a", "c"],
          "rows": [
            [1, null, null],
            [4, 2, 3]
          ]
        }
      }
    ]
  },
  {
    "description": "json object rows at a jsonPointer in first-seen key order",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#rowtype",
      "https://fairspec.org/specs/file-dialect/#jsonpointer"
    ],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/rows"
    },
    "tests": [
      {
        "description": "a key first seen on a later row follows the earlier keys",
        "data": "{\"rows\":[{\"b\":1},{\"a\":2,\"b\":4}]}",
        "expected": {
          "columns": ["b", "a"],
          "rows": [
            [1, null],
            [4, 2]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonl object rows in first-seen key order",
    "specification": ["https://fairspec.org/specs/file-dialect/#rowtype"],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl",
      "rowType": "object"
    },
    "tests": [
      {
        "description": "a key first seen on a later line follows the earlier keys",
        "data": "{\"b\":1}\n{\"a\":2,\"c\":3,\"b\":4}\n",
        "expected": {
          "columns": ["b", "a", "c"],
          "rows": [
            [1, null, null],
            [4, 2, 3]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames on json object rows",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#rowtype",
      "https://fairspec.org/specs/file-dialect/#columnnames"
    ],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "object",
      "columnNames": ["b", "z"]
    },
    "tests": [
      {
        "description": "a key no row has is a null column",
        "data": "[{\"a\":1},{\"a\":2,\"b\":3}]",
        "expected": {
          "columns": ["b", "z"],
          "rows": [
            [null, null],
            [3, null]
          ]
        }
      }
    ]
  },
