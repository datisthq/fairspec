[
  {
    "description": "jsonPointer to a nested array",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/data/items"
    },
    "tests": [
      {
        "description": "rows are read from the pointed array",
        "data": "{\"metadata\":{\"version\":\"1.0\"},\"data\":{\"items\":[{\"id\":1,\"name\":\"apple\"},{\"id\":2,\"name\":\"orange\"}]}}",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonPointer to a top-level property",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/items"
    },
    "tests": [
      {
        "description": "rows are read from the pointed array",
        "data": "{\"items\":[{\"id\":1,\"name\":\"apple\"}]}",
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "rowType array with a header row",
    "specification": ["https://fairspec.org/specs/file-dialect/#rowtype"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "array"
    },
    "tests": [
      {
        "description": "the first array names the columns",
        "data": [
          ["id", "name"],
          [1, "apple"],
          [2, "orange"]
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "rowType array with columnNames",
    "comment": "The spec's own rowType example: headerless arrays named by columnNames",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#rowtype",
      "https://fairspec.org/specs/file-dialect/#columnnames"
    ],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "array",
      "headerRows": false,
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "every array is a row",
        "data": [
          [1, "apple"],
          [2, "orange"]
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "json empty array with columnNames",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#json",
      "https://fairspec.org/specs/file-dialect/#columnnames"
    ],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "object",
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "there are no rows",
        "data": [],
        "expected": {
          "columns": ["id", "name"],
          "rows": []
        }
      }
    ]
  },
  {
    "description": "rowType object",
    "specification": ["https://fairspec.org/specs/file-dialect/#rowtype"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "object"
    },
    "tests": [
      {
        "description": "every object is a row",
        "data": [
          {
            "id": 1,
            "name": "apple"
          },
          {
            "id": 2,
            "name": "orange"
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonl rowType array",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#jsonl",
      "https://fairspec.org/specs/file-dialect/#rowtype"
    ],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl",
      "rowType": "array"
    },
    "tests": [
      {
        "description": "the first line names the columns",
        "data": "[\"id\",\"name\"]\n[1,\"apple\"]\n[2,\"orange\"]\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonl rowType object",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#jsonl",
      "https://fairspec.org/specs/file-dialect/#rowtype"
    ],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl",
      "rowType": "object"
    },
    "tests": [
      {
        "description": "every line is a row",
        "data": "{\"id\":1,\"name\":\"apple\"}\n{\"id\":2,\"name\":\"orange\"}\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonl columnNames",
    "comment": "columnNames select and order the columns of object rows",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl",
      "columnNames": ["name", "id"]
    },
    "tests": [
      {
        "description": "the names pick the keys",
        "data": "{\"id\":1,\"name\":\"apple\"}\n",
        "expected": {
          "columns": ["name", "id"],
          "rows": [["apple", 1]]
        }
      }
    ]
  },
  {
    "description": "commentRows on json objects",
    "fileDialect": {
      "format": "json",
      "rowType": "object",
      "commentRows": [1]
    },
    "tests": [
      {
        "description": "commentRows does not apply",
        "data": [
          {
            "id": 1
          },
          {
            "id": 2
          }
        ],
        "expected": {
          "columns": ["id"],
          "rows": [[1], [2]]
        }
      }
    ],
    "specification": ["https://fairspec.org/specs/file-dialect/#commentrows"]
  },
  {
    "description": "jsonPointer with an escaped slash",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/a~1b"
    },
    "tests": [
      {
        "description": "~1 stands for a slash in the key",
        "data": "{\"a/b\":[{\"id\":1}],\"a\":{\"b\":[{\"id\":2}]}}",
        "expected": {
          "columns": ["id"],
          "rows": [[1]]
        }
      }
    ]
  },
  {
    "description": "jsonPointer with an escaped tilde",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/a~0b"
    },
    "tests": [
      {
        "description": "~0 stands for a tilde in the key",
        "data": "{\"a~b\":[{\"id\":1}]}",
        "expected": {
          "columns": ["id"],
          "rows": [[1]]
        }
      }
    ]
  },
  {
    "description": "jsonPointer with ~01",
    "comment": "RFC 6901 decodes ~1 before ~0, so ~01 is ~1",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/~01"
    },
    "tests": [
      {
        "description": "~01 stands for the key ~1, not a slash",
        "data": "{\"~1\":[{\"id\":1}],\"/\":[{\"id\":2}]}",
        "expected": {
          "columns": ["id"],
          "rows": [[1]]
        }
      }
    ]
  },
  {
    "description": "jsonPointer with an array index",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/pages/1/rows"
    },
    "tests": [
      {
        "description": "a number picks an item of an array",
        "data": "{\"pages\":[{\"rows\":[{\"id\":1}]},{\"rows\":[{\"id\":2}]}]}",
        "expected": {
          "columns": ["id"],
          "rows": [[2]]
        }
      }
    ]
  },
  {
    "description": "jsonPointer to the empty key",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/"
    },
    "tests": [
      {
        "description": "/ points to the key that is the empty string",
        "data": "{\"\":[{\"id\":1}],\"x\":[{\"id\":2}]}",
        "expected": {
          "columns": ["id"],
          "rows": [[1]]
        }
      }
    ]
  },
  {
    "description": "jsonPointer empty string",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": ""
    },
    "tests": [
      {
        "description": "the whole document is the array",
        "data": [
          {
            "id": 1
          },
          {
            "id": 2
          }
        ],
        "expected": {
          "columns": ["id"],
          "rows": [[1], [2]]
        }
      }
    ]
  },
  {
    "description": "jsonPointer to an empty array",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#jsonpointer",
      "https://fairspec.org/specs/file-dialect/#columnnames"
    ],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/items",
      "rowType": "object",
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "there are no rows",
        "data": "{\"items\":[]}",
        "expected": {
          "columns": ["id", "name"],
          "rows": []
        }
      }
    ]
  },
  {
    "description": "jsonPointer to a key with a space",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonpointer"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "jsonPointer": "/my items"
    },
    "tests": [
      {
        "description": "the key is matched as is",
        "data": "{\"my items\":[{\"id\":1}]}",
        "expected": {
          "columns": ["id"],
          "rows": [[1]]
        }
      }
    ]
  },
  {
    "description": "json without rowType, first item an array",
    "comment": "Without rowType the first item decides; headerRows defaults to [1]",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#rowtype",
      "https://fairspec.org/specs/file-dialect/#headerrows"
    ],
    "format": "json",
    "fileDialect": {
      "format": "json"
    },
    "tests": [
      {
        "description": "the rows are arrays and the first is the header",
        "data": [
          ["id", "name"],
          [1, "apple"]
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "json without rowType, first item an object",
    "specification": ["https://fairspec.org/specs/file-dialect/#rowtype"],
    "format": "json",
    "fileDialect": {
      "format": "json"
    },
    "tests": [
      {
        "description": "the rows are objects",
        "data": [
          {
            "id": 1,
            "name": "apple"
          }
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "jsonl without rowType, first item an array",
    "comment": "Without rowType the first item decides; headerRows defaults to [1]",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#rowtype",
      "https://fairspec.org/specs/file-dialect/#headerrows"
    ],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl"
    },
    "tests": [
      {
        "description": "the rows are arrays and the first is the header",
        "data": "[\"id\",\"name\"]\n[1,\"apple\"]\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "jsonl with crlf lines",
    "comment": "A \\r before the newline is JSON whitespace, so each line parses as the same value",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonl"],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl"
    },
    "tests": [
      {
        "description": "objects on crlf lines",
        "data": "{\"id\":1,\"name\":\"apple\"}\r\n{\"id\":2,\"name\":\"orange\"}\r\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "jsonl arrays with crlf lines",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonl"],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl",
      "rowType": "array"
    },
    "tests": [
      {
        "description": "the first line names the columns",
        "data": "[\"id\",\"name\"]\r\n[1,\"apple\"]\r\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "jsonl without a trailing newline",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonl"],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl"
    },
    "tests": [
      {
        "description": "the last line is still a row",
        "data": "{\"id\":1}\n{\"id\":2}",
        "expected": {
          "columns": ["id"],
          "rows": [[1], [2]]
        }
      },
      {
        "description": "a single line is one row",
        "data": "{\"id\":1}",
        "expected": {
          "columns": ["id"],
          "rows": [[1]]
        }
      }
    ]
  },
  {
    "description": "jsonl non-ASCII values",
    "specification": ["https://fairspec.org/specs/file-dialect/#jsonl"],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl"
    },
    "tests": [
      {
        "description": "text is kept",
        "data": "{\"name\":\"José\",\"city\":\"東京\"}\n",
        "expected": {
          "columns": ["name", "city"],
          "rows": [["José", "東京"]]
        }
      }
    ]
  }
]
