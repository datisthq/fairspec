[
  {
    "description": "columnNames for a headerless file",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "headerRows": false,
      "columnNames": ["id", "name", "price"]
    },
    "tests": [
      {
        "description": "the names are used for the columns",
        "data": "1,apple,1.5\n2,orange,2.0\n",
        "expected": {
          "columns": ["id", "name", "price"],
          "rows": [
            [1, "apple", 1.5],
            [2, "orange", 2.0]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames for a tsv file",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "tsv",
    "fileDialect": {
      "format": "tsv",
      "headerRows": false,
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "the names are used for the columns",
        "data": "1\tapple\n2\torange\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames instead of the header row",
    "comment": "columnNames are used instead of deriving names from the file; the header row is still not data",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "headerRows": [1],
      "columnNames": ["key", "label"]
    },
    "tests": [
      {
        "description": "the names replace the header",
        "data": "id,name\n1,apple\n2,orange\n",
        "expected": {
          "columns": ["key", "label"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames instead of joined header rows",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#columnnames",
      "https://fairspec.org/specs/file-dialect/#headerrows"
    ],
    "fileDialect": {
      "format": "csv",
      "headerRows": [1, 2],
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "the names replace both header rows",
        "data": "a,b\nc,d\n1,apple\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "columnNames on json objects",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "object",
      "columnNames": ["name", "id"]
    },
    "tests": [
      {
        "description": "the names pick the keys in their order",
        "data": [
          {
            "id": 1,
            "name": "apple"
          },
          {
            "id": 2,
            "name": "orange"
          }
        ],
        "expected": {
          "columns": ["name", "id"],
          "rows": [
            ["apple", 1],
            ["orange", 2]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames instead of a json header array",
    "comment": "columnNames are used instead of deriving names from the file; the header row is still not data",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "array",
      "headerRows": [1],
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "the names replace the header",
        "data": [
          ["a", "b"],
          [1, "apple"]
        ],
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "columnNames instead of a tsv header row",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "tsv",
    "fileDialect": {
      "format": "tsv",
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "the names replace the header",
        "data": "a\tb\n1\tapple\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "columnNames with non-ASCII names",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "headerRows": false,
      "columnNames": ["número", "名前"]
    },
    "tests": [
      {
        "description": "the names are used as given",
        "data": "1,apple\n",
        "expected": {
          "columns": ["número", "名前"],
          "rows": [[1, "apple"]]
        }
      }
    ]
  },
  {
    "description": "columnNames for jsonl arrays",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#columnnames",
      "https://fairspec.org/specs/file-dialect/#rowtype"
    ],
    "format": "jsonl",
    "fileDialect": {
      "format": "jsonl",
      "rowType": "array",
      "headerRows": false,
      "columnNames": ["id", "name"]
    },
    "tests": [
      {
        "description": "every line is a row",
        "data": "[1,\"apple\"]\n[2,\"orange\"]\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "apple"],
            [2, "orange"]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames fewer than the columns",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "headerRows": false,
      "columnNames": ["a", "b"]
    },
    "tests": [
      {
        "description": "is an error",
        "data": "1,2,3\n4,5,6\n",
        "throws": true
      }
    ]
  },
  {
    "description": "columnNames fewer than the header's columns",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "columnNames": ["a", "b"]
    },
    "tests": [
      {
        "description": "is an error",
        "data": "x,y,z\n1,2,3\n",
        "throws": true
      }
    ]
  },
  {
    "description": "columnNames more than the columns",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "headerRows": false,
      "columnNames": ["a", "b", "c"]
    },
    "tests": [
      {
        "description": "the extra names are null columns",
        "data": "1,2\n3,4\n",
        "expected": {
          "columns": ["a", "b", "c"],
          "rows": [
            [1, 2, null],
            [3, 4, null]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames more than the header's columns",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "fileDialect": {
      "format": "csv",
      "columnNames": ["a", "b", "c"]
    },
    "tests": [
      {
        "description": "the extra names are null columns",
        "data": "x,y\n1,2\n",
        "expected": {
          "columns": ["a", "b", "c"],
          "rows": [[1, 2, null]]
        }
      }
    ]
  },
  {
    "description": "columnNames more than the columns of json arrays",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "array",
      "headerRows": false,
      "columnNames": ["a", "b", "c"]
    },
    "tests": [
      {
        "description": "the extra names are null columns",
        "data": "[[1,2],[3,4]]",
        "expected": {
          "columns": ["a", "b", "c"],
          "rows": [
            [1, 2, null],
            [3, 4, null]
          ]
        }
      }
    ]
  },
  {
    "description": "columnNames fewer than the columns of json arrays",
    "specification": ["https://fairspec.org/specs/file-dialect/#columnnames"],
    "format": "json",
    "fileDialect": {
      "format": "json",
      "rowType": "array",
      "headerRows": false,
      "columnNames": ["a"]
    },
    "tests": [
      {
        "description": "is an error",
        "data": "[[1,2],[3,4]]",
        "throws": true
      }
    ]
  },
  {
    "description": "columnNames with a header row past the end of the file",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#columnnames",
      "https://fairspec.org/specs/file-dialect/#headerrows"
    ],
    "fileDialect": {
      "format": "csv",
      "headerRows": [1, 3],
      "columnNames": ["x", "y"]
    },
    "tests": [
      {
        "description": "is an error",
        "data": "a,b\n1,2\n",
        "throws": true
      }
    ]
  }
]
