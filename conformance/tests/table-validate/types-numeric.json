    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["integer", "null"]
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,1\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "nullable boolean column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#boolean"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["boolean", "null"]
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,true\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "nullable string column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#string"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"]
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,a\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "type with null listed first",
    "comment": "The spec makes the null in a type union order insensitive",
    "specification": ["https://fairspec.org/specs/table-schema/#type"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["null", "number"]
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,1.5\n2,\n",
        "valid": true
      },
      {
        "description": "a word is a cell/type error",
        "data": "id,x\n1,1.5\n2,abc\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "abc"
          }
        ]
      }
    ]
  },
  {
    "description": "integer column: whole numbers at the 64-bit limits",
    "comment": "Whole numbers that a binary double cannot hold exactly are still integers",
    "specification": ["https://fairspec.org/specs/table-schema/#integer"],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "integer" } }
    },
    "tests": [
      {
        "description": "2^53 + 1 is a whole number",
        "data": "id,x\n1,9007199254740993\n",
        "valid": true
      },
      {
        "description": "the largest and smallest 64-bit integers are whole numbers",
        "data": "id,x\n1,9223372036854775807\n2,-9223372036854775808\n",
        "valid": true
      }
    ]
  },
  {
    "description": "integer column: separators without groupChar",
    "comment": "groupChar: without it, a value has no group separator",
    "specification": [
      "https://fairspec.org/specs/table-schema/#integer",
      "https://fairspec.org/specs/table-schema/#groupchar"
    ],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "integer" } }
    },
    "tests": [
      {
        "description": "a comma group separator is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,000\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "1,000"
          }
        ]
      },
      {
        "description": "a space group separator is a cell/type error",
        "data": "id,x\n1,1\n2,1 000\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "1 000"
          }
        ]
      },
      {
        "description": "a dot group separator is a cell/type error",
        "data": "id,x\n1,1\n2,1.000.000\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "1.000.000"
          }
        ]
      }
    ]
  },
  {
    "description": "integer column: a fractional part",
    "specification": ["https://fairspec.org/specs/table-schema/#integer"],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "integer" } }
    },
    "tests": [
      {
        "description": "a negative decimal is a cell/type error",
        "data": "id,x\n1,1\n2,-2.5\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "-2.5"
          }
        ]
      },
      {
        "description": "a decimal comma is a cell/type error",
        "data": "id,x\n1,1\n2,\"2,5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "2,5"
          }
        ]
      }
    ]
  },
  {
    "description": "number column: separators and malformed numbers",
    "specification": [
      "https://fairspec.org/specs/table-schema/#number",
      "https://fairspec.org/specs/table-schema/#groupchar"
    ],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "number" } }
    },
    "tests": [
      {
        "description": "a comma group separator without groupChar is a cell/type error",
        "data": "id,x\n1,1.5\n2,\"1,000.5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1,000.5"
          }
        ]
      },
      {
        "description": "two decimal points are a cell/type error",
        "data": "id,x\n1,1.5\n2,1.2.3\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1.2.3"
          }
        ]
      },
      {
        "description": "a space between digits is a cell/type error",
        "data": "id,x\n1,1.5\n2,1 5\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1 5"
          }
        ]
      },
      {
        "description": "a number followed by a unit without withText is a cell/type error",
        "data": "id,x\n1,1.5\n2,1.5 kg\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1.5 kg"
          }
        ]
      },
      {
        "description": "a currency prefix without withText is a cell/type error",
        "data": "id,x\n1,1.5\n2,$1.5\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "$1.5"
          }
        ]
      }
    ]
  },
  {
    "description": "decimal column: precision and malformed decimals",
    "specification": [
      "https://fairspec.org/specs/table-schema/#decimal",
      "https://fairspec.org/specs/table-schema/#groupchar"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "decimal" }
      }
    },
    "tests": [
      {
        "description": "digits beyond binary floating point precision are valid",
        "data": "id,x\n1,12345678901234567.89\n2,0.30000000000000001\n",
        "valid": true
      },
      {
        "description": "trailing zeros are valid",
        "data": "id,x\n1,1.10\n2,1.100\n3,0.0\n",
        "valid": true
      },
      {
        "description": "two decimal points are a cell/type error",
        "data": "id,x\n1,1.5\n2,1.2.3\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "decimal",
            "rowNumber": 2,
            "cell": "1.2.3"
          }
        ]
      },
      {
        "description": "a comma group separator without groupChar is a cell/type error",
        "data": "id,x\n1,1.5\n2,\"1,000.5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "decimal",
            "rowNumber": 2,
            "cell": "1,000.5"
          }
        ]
      },
      {
        "description": "a currency prefix without withText is a cell/type error",
        "data": "id,x\n1,1.5\n2,$1.5\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "decimal",
            "rowNumber": 2,
            "cell": "$1.5"
          }
        ]
      }
    ]
  },
  {
    "description": "number column: the JSON number grammar",
    "specification": ["https://fairspec.org/specs/table-schema/#number"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "number"
        }
      }
    },
    "tests": [
      {
        "description": "numbers in the JSON grammar are valid",
        "data": "id,x\n1,0.5\n2,-2\n3,1E-3\n4,1e3\n5,1.5e+10\n6,0\n7,-0\n8,0.0\n9,-0.5\n10,1E+2\n",
        "valid": true
      },
      {
        "description": "a plus sign is a cell/type error",
        "data": "id,x\n1,1.5\n2,+1\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "+1"
          }
        ]
      },
      {
        "description": "leading zeros is a cell/type error",
        "data": "id,x\n1,1.5\n2,007\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "007"
          }
        ]
      },
      {
        "description": "two zeros is a cell/type error",
        "data": "id,x\n1,1.5\n2,00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "00"
          }
        ]
      },
      {
        "description": "a fraction without an integer part is a cell/type error",
        "data": "id,x\n1,1.5\n2,.5\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": ".5"
          }
        ]
      },
      {
        "description": "a fraction without digits is a cell/type error",
        "data": "id,x\n1,1.5\n2,5.\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "5."
          }
        ]
      },
      {
        "description": "a leading space is a cell/type error",
        "data": "id,x\n1,1.5\n2, 1\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": " 1"
          }
        ]
      },
      {
        "description": "a trailing space is a cell/type error",
        "data": "id,x\n1,1.5\n2,1 \n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1 "
          }
        ]
      },
      {
        "description": "hexadecimal is a cell/type error",
        "data": "id,x\n1,1.5\n2,0x10\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "0x10"
          }
        ]
      },
      {
        "description": "NaN is a cell/type error",
        "data": "id,x\n1,1.5\n2,NaN\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "NaN"
          }
        ]
      },
      {
        "description": "Infinity is a cell/type error",
        "data": "id,x\n1,1.5\n2,Infinity\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "Infinity"
          }
        ]
      },
      {
        "description": "-Infinity is a cell/type error",
        "data": "id,x\n1,1.5\n2,-Infinity\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "-Infinity"
          }
        ]
      },
      {
        "description": "inf is a cell/type error",
        "data": "id,x\n1,1.5\n2,inf\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "inf"
          }
        ]
      },
      {
        "description": "an exponent without digits is a cell/type error",
        "data": "id,x\n1,1.5\n2,1e\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1e"
          }
        ]
      },
      {
        "description": "an exponent without a mantissa is a cell/type error",
        "data": "id,x\n1,1.5\n2,e5\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "e5"
          }
        ]
      },
      {
        "description": "a lone minus is a cell/type error",
        "data": "id,x\n1,1.5\n2,-\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "-"
          }
        ]
      },
      {
        "description": "an exponent sign without digits is a cell/type error",
        "data": "id,x\n1,1.5\n2,1e+\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1e+"
          }
        ]
      },
      {
        "description": "a Unicode minus sign is a cell/type error",
        "data": "id,x\n1,1.5\n2,−1\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "−1"
          }
        ]
      },
      {
        "description": "full-width digits is a cell/type error",
        "data": "id,x\n1,1.5\n2,１\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "１"
          }
        ]
      },
      {
        "description": "an underscore separator is a cell/type error",
        "data": "id,x\n1,1.5\n2,1_000\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "1_000"
          }
        ]
      },
      {
        "description": "two minus signs is a cell/type error",
        "data": "id,x\n1,1.5\n2,--1\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "--1"
          }
        ]
      },
      {
        "description": "a negative with leading zeros is a cell/type error",
        "data": "id,x\n1,1.5\n2,-01\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "number",
            "rowNumber": 2,
            "cell": "-01"
          }
        ]
      }
    ]
  },
  {
    "description": "integer column: a number with a zero fraction",
    "specification": [
      "https://fairspec.org/specs/table-schema/#integer",
      "https://fairspec.org/specs/table-schema/#number"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "integer"
        }
      }
    },
    "tests": [
      {
        "description": "whole numbers in the JSON grammar are valid",
        "data": "id,x\n1,1.0\n2,1e3\n3,1E2\n4,-0\n5,0\n6,1.50e1\n7,-2.0\n8,0.0e0\n9,100e-2\n",
        "valid": true
      },
      {
        "description": "a fraction is a cell/type error",
        "data": "id,x\n1,1\n2,1.5\n",
        "valid": false,
