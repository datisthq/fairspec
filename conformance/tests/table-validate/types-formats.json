  {
    "description": "wkt column",
    "specification": ["https://fairspec.org/specs/table-schema/#wkt"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "wkt"
        }
      }
    },
    "tests": [
      {
        "description": "points, lines and polygons are valid",
        "data": "id,x\n1,\"POINT (30 10)\"\n2,\"LINESTRING (30 10, 10 30, 40 40)\"\n3,\"POLYGON ((30 10, 40 40, 20 40, 10 20, 30 10))\"\n",
        "valid": true
      },
      {
        "description": "an unknown geometry is a cell/type error",
        "data": "id,x\n1,\"POINT (30 10)\"\n2,\"CIRCLE (30 10)\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "CIRCLE (30 10)"
          }
        ]
      },
      {
        "description": "a word is a cell/type error",
        "data": "id,x\n1,\"POINT (30 10)\"\n2,hello\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "hello"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,\"POINT (30 10)\"\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
