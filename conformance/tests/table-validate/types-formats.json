        "description": "an empty cell is valid",
        "data": "id,x\n1,\"POINT (30 10)\"\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "wkb column",
    "comment": "01010000000000000000003E400000000000002440 is POINT (30 10) as little-endian WKB in hex",
    "specification": ["https://fairspec.org/specs/table-schema/#wkb"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "wkb"
        }
      }
    },
    "tests": [
      {
        "description": "a hex-encoded point is valid",
        "data": "id,x\n1,01010000000000000000003E400000000000002440\n",
        "valid": true
      },
      {
        "description": "a truncated geometry is a cell/type error",
        "data": "id,x\n1,01010000000000000000003E400000000000002440\n2,0101000000\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkb",
            "rowNumber": 2,
            "cell": "0101000000"
          }
        ]
      },
      {
        "description": "non-hex text is a cell/type error",
        "data": "id,x\n1,01010000000000000000003E400000000000002440\n2,hello\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkb",
            "rowNumber": 2,
            "cell": "hello"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,01010000000000000000003E400000000000002440\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable wkb column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#wkb"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "wkb"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,01010000000000000000003E400000000000002440\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "url column: forms",
    "comment": "A URL column holds URLs with the HTTP or HTTPS protocol",
    "specification": ["https://fairspec.org/specs/table-schema/#url"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "url" }
      }
    },
    "tests": [
      {
        "description": "a port, path, query and fragment are valid",
        "data": "id,x\n1,https://example.com:8080/a/b?q=1&r=2#frag\n",
        "valid": true
      },
      {
        "description": "an IP address host is valid",
        "data": "id,x\n1,http://192.168.0.1/\n2,http://[::1]:8080/\n",
        "valid": true
      },
      {
        "description": "a mailto URL is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,mailto:alice@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "mailto:alice@example.com"
          }
        ]
      },
      {
        "description": "a file URL is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,file:///etc/hosts\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "file:///etc/hosts"
          }
        ]
      },
      {
        "description": "a WebSocket URL is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,wss://example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "wss://example.com"
          }
        ]
      },
      {
        "description": "a protocol-relative URL is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,//example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "//example.com"
          }
        ]
      },
      {
        "description": "a relative path is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,/a/b\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "/a/b"
          }
        ]
      }
    ]
  },
  {
    "description": "email column: forms",
    "specification": ["https://fairspec.org/specs/table-schema/#email"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "email" }
      }
    },
    "tests": [
      {
        "description": "dots, plus tags and subdomains are valid",
        "data": "id,x\n1,alice.smith+tag@mail.example.co.uk\n",
        "valid": true
      },
      {
        "description": "two at signs are a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,a@b@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "a@b@example.com"
          }
        ]
      },
      {
        "description": "a missing local part is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "@example.com"
          }
        ]
      },
      {
        "description": "a space in the local part is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,alice smith@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "alice smith@example.com"
          }
        ]
      }
    ]
  },
  {
    "description": "hex column: forms",
    "specification": ["https://fairspec.org/specs/table-schema/#hex"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "hex" }
      }
    },
    "tests": [
      {
        "description": "mixed case is valid",
        "data": "id,x\n1,aBcDeF\n2,0123456789abcdef\n",
        "valid": true
      },
      {
        "description": "a space between bytes is a cell/type error",
        "data": "id,x\n1,aBcDeF\n2,FF 57\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "hex",
            "rowNumber": 2,
            "cell": "FF 57"
          }
        ]
      }
    ]
  },
  {
    "description": "base64 column: forms",
    "specification": ["https://fairspec.org/specs/table-schema/#base64"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "base64" }
      }
    },
    "tests": [
      {
        "description": "one and two padding characters are valid",
        "data": "id,x\n1,aGVsbG8=\n2,aGk=\n3,aGVsbG8hIQ==\n",
        "valid": true
      },
      {
        "description": "padding in the middle is a cell/type error",
        "data": "id,x\n1,aGVsbG8=\n2,aG=sbG8=\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "aG=sbG8="
          }
        ]
      },
      {
        "description": "a space is a cell/type error",
        "data": "id,x\n1,aGVsbG8=\n2,aGVs bG8=\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "aGVs bG8="
          }
        ]
      }
    ]
  },
  {
    "description": "wkt column: forms",
    "specification": ["https://fairspec.org/specs/table-schema/#wkt"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "wkt" }
      }
    },
    "tests": [
      {
        "description": "empty geometries are valid",
        "data": "id,x\n1,POINT EMPTY\n2,GEOMETRYCOLLECTION EMPTY\n",
        "valid": true
      },
      {
        "description": "multi-geometries and collections are valid",
        "data": "id,x\n1,\"MULTIPOINT ((10 40), (40 30))\"\n2,\"MULTILINESTRING ((10 10, 20 20), (40 40, 30 30))\"\n3,\"MULTIPOLYGON (((30 20, 45 40, 10 40, 30 20)), ((15 5, 40 10, 10 20, 5 10, 15 5)))\"\n4,\"GEOMETRYCOLLECTION (POINT (4 6), LINESTRING (4 6, 7 10))\"\n",
        "valid": true
      },
      {
        "description": "three-dimensional and measured points are valid",
        "data": "id,x\n1,POINT Z (1 2 3)\n2,POINT M (1 2 3)\n3,POINT ZM (1 2 3 4)\n",
        "valid": true
      },
      {
        "description": "negative and decimal coordinates are valid",
        "data": "id,x\n1,POINT (-71.06 42.36)\n",
        "valid": true
      },
      {
        "description": "a point with one coordinate is a cell/type error",
        "data": "id,x\n1,POINT (30 10)\n2,POINT (30)\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "POINT (30)"
          }
        ]
      },
      {
        "description": "a missing closing parenthesis is a cell/type error",
        "data": "id,x\n1,POINT (30 10)\n2,POINT (30 10\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "POINT (30 10"
          }
        ]
      },
      {
        "description": "a non-numeric coordinate is a cell/type error",
        "data": "id,x\n1,POINT (30 10)\n2,POINT (a b)\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "POINT (a b)"
          }
        ]
      },
      {
        "description": "trailing text is a cell/type error",
        "data": "id,x\n1,POINT (30 10)\n2,POINT (30 10) x\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "POINT (30 10) x"
          }
        ]
      },
      {
        "description": "a geometry type with trailing letters is a cell/type error",
        "data": "id,x\n1,POINT (30 10)\n2,POINTX (30 10)\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "POINTX (30 10)"
          }
        ]
      }
    ]
  },
  {
    "description": "wkb column: forms",
    "comment": "WKB cells are hex text; byte 1 is the byte order, then a 4-byte geometry type",
    "specification": ["https://fairspec.org/specs/table-schema/#wkb"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "wkb" }
      }
    },
    "tests": [
      {
        "description": "a big-endian point is valid",
        "data": "id,x\n1,00000000013FF00000000000004000000000000000\n",
        "valid": true
      },
      {
        "description": "a little-endian line is valid",
        "data": "id,x\n1,01020000000200000000000000000000000000000000000000000000000000F03F000000000000F03F\n",
        "valid": true
      },
      {
        "description": "an unknown geometry type is a cell/type error",
        "data": "id,x\n1,0101000000000000000000F03F0000000000000040\n2,0163000000000000000000F03F0000000000000040\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkb",
            "rowNumber": 2,
            "cell": "0163000000000000000000F03F0000000000000040"
          }
        ]
      },
      {
        "description": "an odd number of hex digits is a cell/type error",
        "data": "id,x\n1,0101000000000000000000F03F0000000000000040\n2,0101000000000000000000F03F000000000000004\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkb",
            "rowNumber": 2,
            "cell": "0101000000000000000000F03F000000000000004"
          }
        ]
      },
      {
        "description": "an unknown byte order is a cell/type error",
        "data": "id,x\n1,0101000000000000000000F03F0000000000000040\n2,0201000000000000000000F03F0000000000000040\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkb",
            "rowNumber": 2,
            "cell": "0201000000000000000000F03F0000000000000040"
          }
        ]
      }
    ]
  },
  {
    "description": "url column: RFC 3986",
    "specification": ["https://fairspec.org/specs/table-schema/#url"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "url"
        }
      }
    },
    "tests": [
      {
        "description": "the scheme in any case is valid",
        "data": "id,x\n1,HTTPS://example.com\n2,Http://example.com/a\n",
        "valid": true
      },
      {
        "description": "a single-label host is valid",
        "data": "id,x\n1,http://localhost\n2,http://localhost:8080/\n",
        "valid": true
      },
      {
        "description": "user information is valid",
        "data": "id,x\n1,https://user:pass@example.com/\n",
        "valid": true
      },
      {
        "description": "percent-encoded characters are valid",
        "data": "id,x\n1,https://example.com/caf%C3%A9?q=%20\n",
        "valid": true
      },
      {
        "description": "an empty port, path, query and fragment are valid",
        "data": "id,x\n1,http://example.com:/?#\n",
        "valid": true
      },
      {
        "description": "an IPv4 host is valid",
        "data": "id,x\n1,http://192.0.2.1:80/\n",
        "valid": true
      },
      {
        "description": "an IPv6 host is valid",
        "data": "id,x\n1,http://[2001:db8::1]/\n2,http://[::ffff:192.0.2.1]/\n",
        "valid": true
      },
      {
        "description": "an empty host is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,http:///path\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "http:///path"
          }
        ]
      },
      {
        "description": "a scheme with nothing after it is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://"
          }
        ]
      },
      {
        "description": "a single slash is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,http:/example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "http:/example.com"
          }
        ]
      },
      {
        "description": "a non-ASCII host is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://exämple.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://exämple.com"
          }
        ]
      },
      {
        "description": "a non-ASCII path is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://example.com/café\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://example.com/café"
          }
        ]
      },
      {
        "description": "a space is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://example.com/a b\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://example.com/a b"
          }
        ]
      },
      {
        "description": "a malformed percent-encoding is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://example.com/%zz\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://example.com/%zz"
          }
        ]
      },
      {
        "description": "a second fragment is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://example.com/#a#b\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://example.com/#a#b"
          }
        ]
      },
      {
        "description": "a port with letters is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://example.com:80a/\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://example.com:80a/"
          }
        ]
      },
      {
        "description": "an unclosed IPv6 host is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,http://[::1/\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "http://[::1/"
          }
        ]
      },
      {
        "description": "an IPv6 host with too many groups is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,http://[1:2:3:4:5:6:7:8:9]/\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "http://[1:2:3:4:5:6:7:8:9]/"
          }
        ]
      },
      {
        "description": "angle brackets are a cell/type error",
        "data": "id,x\n1,https://example.com\n2,https://example.com/<a>\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "https://example.com/<a>"
          }
        ]
      }
    ]
  },
  {
    "description": "email column: RFC 5321 Mailbox",
    "specification": ["https://fairspec.org/specs/table-schema/#email"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "tests": [
      {
        "description": "a quoted local part is valid",
        "data": "id,x\n1,\"\"\"john doe\"\"@example.com\"\n2,\"\"\"a\\\"\"b\"\"@example.com\"\n",
        "valid": true
      },
      {
        "description": "an address literal is valid",
        "data": "id,x\n1,user@[192.0.2.1]\n2,user@[IPv6:2001:db8::1]\n",
        "valid": true
      },
      {
        "description": "a single-label domain is valid",
        "data": "id,x\n1,user@localhost\n",
        "valid": true
      },
      {
        "description": "every atext character is valid in the local part",
        "data": "id,x\n1,!#$%&'*+-/=?^_`{|}~@example.com\n",
        "valid": true
      },
      {
        "description": "hyphens and digits in a domain are valid",
        "data": "id,x\n1,user@my-host.example\n2,user@123.example.com\n",
        "valid": true
      },
      {
        "description": "a non-ASCII local part is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,jürgen@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "jürgen@example.com"
          }
        ]
      },
      {
        "description": "a non-ASCII domain is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,user@exämple.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "user@exämple.com"
          }
        ]
      },
      {
        "description": "a leading dot is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,.alice@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": ".alice@example.com"
          }
        ]
      },
      {
        "description": "a trailing dot in the local part is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,alice.@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "alice.@example.com"
          }
        ]
      },
      {
        "description": "two dots in a row are a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,alice..bob@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "alice..bob@example.com"
          }
        ]
      },
      {
        "description": "a label starting with a hyphen is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,user@-example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "user@-example.com"
          }
        ]
      },
      {
        "description": "a label ending with a hyphen is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,user@example-.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "user@example-.com"
          }
        ]
      },
      {
        "description": "a trailing dot in the domain is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,user@example.com.\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "user@example.com."
          }
        ]
      },
      {
        "description": "an IPv4 literal above 255 is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,user@[300.1.1.1]\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "user@[300.1.1.1]"
          }
        ]
      },
      {
        "description": "an unquoted space is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,a b@example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "a b@example.com"
          }
        ]
      },
      {
        "description": "an unclosed quoted string is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,\"\"\"alice@example.com\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "\"alice@example.com"
          }
        ]
      }
    ]
  },
  {
    "description": "hex column: digits in pairs",
    "specification": ["https://fairspec.org/specs/table-schema/#hex"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "hex"
        }
      }
    },
    "tests": [
      {
        "description": "pairs of digits in any case are valid",
        "data": "id,x\n1,AbCd\n2,00\n3,0123456789ABCDEF\n",
        "valid": true
      },
      {
        "description": "an odd number of digits is a cell/type error",
        "data": "id,x\n1,ff\n2,abc\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "hex",
            "rowNumber": 2,
            "cell": "abc"
          }
        ]
      },
      {
        "description": "a 0x prefix is a cell/type error",
        "data": "id,x\n1,ff\n2,0xff\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "hex",
            "rowNumber": 2,
            "cell": "0xff"
          }
        ]
      },
      {
        "description": "a leading space is a cell/type error",
        "data": "id,x\n1,ff\n2, ff\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "hex",
            "rowNumber": 2,
            "cell": " ff"
          }
        ]
      },
      {
        "description": "a fullwidth digit is a cell/type error",
        "data": "id,x\n1,ff\n2,ff００\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "hex",
            "rowNumber": 2,
            "cell": "ff００"
          }
        ]
      }
    ]
  },
  {
    "description": "base64 column: RFC 4648 section 4",
    "specification": ["https://fairspec.org/specs/table-schema/#base64"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "base64"
        }
      }
    },
    "tests": [
      {
        "description": "the standard alphabet with padding is valid",
        "data": "id,x\n1,+/+/\n2,AA==\n3,AAA=\n",
        "valid": true
      },
      {
        "description": "a value without its padding is a cell/type error",
        "data": "id,x\n1,aGk=\n2,aGk\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "aGk"
          }
        ]
      },
      {
        "description": "the URL-safe alphabet is a cell/type error",
        "data": "id,x\n1,aGk=\n2,-_-_\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "-_-_"
          }
        ]
      },
      {
        "description": "a line break is a cell/type error",
        "data": "id,x\n1,aGk=\n2,\"aGVs\nbG8=\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "aGVs\nbG8="
          }
        ]
      },
      {
        "description": "a lone padding character is a cell/type error",
        "data": "id,x\n1,aGk=\n2,=\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "="
          }
        ]
      },
      {
        "description": "three padding characters are a cell/type error",
        "data": "id,x\n1,aGk=\n2,A===\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "base64",
            "rowNumber": 2,
            "cell": "A==="
          }
        ]
      }
    ]
  }
]
