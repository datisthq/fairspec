[
  {
    "description": "email column",
    "specification": ["https://fairspec.org/specs/table-schema/#email"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "tests": [
      {
        "description": "addresses are valid",
        "data": "id,x\n1,alice@example.com\n2,bob@company.org\n",
        "valid": true
      },
      {
        "description": "a bare name is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,alice\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "alice"
          }
        ]
      },
      {
        "description": "a missing domain is a cell/type error",
        "data": "id,x\n1,alice@example.com\n2,alice@\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "email",
            "rowNumber": 2,
            "cell": "alice@"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,alice@example.com\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable email column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#email"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "email"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,alice@example.com\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "url column",
    "comment": "The spec limits URL columns to the HTTP and HTTPS protocols",
    "specification": ["https://fairspec.org/specs/table-schema/#url"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "url"
        }
      }
    },
    "tests": [
      {
        "description": "http and https URLs are valid",
        "data": "id,x\n1,https://example.com\n2,http://example.org/page\n",
        "valid": true
      },
      {
        "description": "a URL without a scheme is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "example.com"
          }
        ]
      },
      {
        "description": "an ftp URL is a cell/type error",
        "data": "id,x\n1,https://example.com\n2,ftp://example.com\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "url",
            "rowNumber": 2,
            "cell": "ftp://example.com"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,https://example.com\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable url column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
