[
  {
    "description": "array column",
    "specification": ["https://fairspec.org/specs/table-schema/#array"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "array"
        }
      }
    },
    "tests": [
      {
        "description": "JSON arrays are valid",
        "data": "id,x\n1,\"[1.5, 2.3]\"\n2,[]\n",
        "valid": true
      },
      {
        "description": "a JSON object is a cell/type error",
        "data": "id,x\n1,[]\n2,\"{\"\"a\"\": 1}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "{\"a\": 1}"
          }
        ]
      },
      {
        "description": "text that is not JSON is a cell/type error",
        "data": "id,x\n1,[]\n2,nope\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "nope"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,[]\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable array column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#array"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["array", "null"]
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,[]\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "array column with a JSON Schema",
    "specification": [
      "https://fairspec.org/specs/table-schema/#array",
      "https://fairspec.org/specs/table-schema/#jsonschema"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        }
      }
    },
    "tests": [
      {
        "description": "number arrays of two or more are valid",
        "data": "id,x\n1,\"[1.5, 2.3]\"\n",
        "valid": true
      },
      {
        "description": "a string item is a cell/json error at its index",
        "data": "id,x\n1,\"[1, \"\"a\"\"]\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/json",
            "columnName": "x",
            "rowNumber": 1,
            "cell": "[1, \"a\"]",
            "jsonPointer": "/1"
          }
        ]
      }
    ]
  },
  {
    "description": "object column",
    "specification": ["https://fairspec.org/specs/table-schema/#object"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "object"
        }
      }
    },
    "tests": [
      {
        "description": "JSON objects are valid",
        "data": "id,x\n1,\"{\"\"author\"\": \"\"Alice\"\", \"\"version\"\": 1}\"\n2,{}\n",
        "valid": true
      },
      {
        "description": "a JSON array is a cell/type error",
        "data": "id,x\n1,{}\n2,[1]\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "[1]"
          }
        ]
      },
      {
        "description": "text that is not JSON is a cell/type error",
        "data": "id,x\n1,{}\n2,nope\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "nope"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,{}\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable object column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#object"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["object", "null"]
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,{}\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "object column with a JSON Schema",
    "specification": [
      "https://fairspec.org/specs/table-schema/#object",
      "https://fairspec.org/specs/table-schema/#jsonschema"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "object",
          "properties": {
            "author": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            }
          }
        }
      }
    },
    "tests": [
      {
        "description": "conforming objects are valid",
        "data": "id,x\n1,\"{\"\"author\"\": \"\"Alice\"\", \"\"version\"\": 1}\"\n",
        "valid": true
      },
      {
        "description": "a wrong property type is a cell/json error at the property",
        "data": "id,x\n1,\"{\"\"author\"\": \"\"Bob\"\", \"\"version\"\": \"\"x\"\"}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/json",
            "columnName": "x",
            "rowNumber": 1,
            "cell": "{\"author\": \"Bob\", \"version\": \"x\"}",
            "jsonPointer": "/version"
          }
        ]
      }
    ]
  },
  {
    "description": "geojson column",
    "specification": ["https://fairspec.org/specs/table-schema/#geojson"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "object",
          "format": "geojson"
        }
      }
    },
    "tests": [
      {
        "description": "GeoJSON geometries are valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [30, 10]}\"\n2,\"{\"\"type\"\": \"\"LineString\"\", \"\"coordinates\"\": [[30, 10], [10, 30]]}\"\n",
        "valid": true
      },
      {
        "description": "an unknown geometry type is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [30, 10]}\"\n2,\"{\"\"type\"\": \"\"Circle\"\", \"\"coordinates\"\": [30, 10]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Circle\", \"coordinates\": [30, 10]}"
          }
        ]
      },
      {
        "description": "a JSON array is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [30, 10]}\"\n2,[1]\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "[1]"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [30, 10]}\"\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable geojson column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#geojson"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["object", "null"],
          "format": "geojson"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [30, 10]}\"\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "topojson column",
    "specification": ["https://fairspec.org/specs/table-schema/#topojson"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "object",
          "format": "topojson"
        }
      }
    },
    "tests": [
      {
        "description": "a topology is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": [[[0, 0], [1, 1]]], \"\"objects\"\": {\"\"line\"\": {\"\"type\"\": \"\"LineString\"\", \"\"arcs\"\": [0]}}}\"\n",
        "valid": true
      },
      {
        "description": "a geometry object is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [30, 10]}\"\n",
        "valid": true
      },
      {
        "description": "an unknown type is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": [[[0, 0], [1, 1]]], \"\"objects\"\": {\"\"line\"\": {\"\"type\"\": \"\"LineString\"\", \"\"arcs\"\": [0]}}}\"\n2,\"{\"\"type\"\": \"\"Circle\"\", \"\"coordinates\"\": [30, 10]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "topojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Circle\", \"coordinates\": [30, 10]}"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": [[[0, 0], [1, 1]]], \"\"objects\"\": {\"\"line\"\": {\"\"type\"\": \"\"LineString\"\", \"\"arcs\"\": [0]}}}\"\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable topojson column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#topojson"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["object", "null"],
          "format": "topojson"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": [[[0, 0], [1, 1]]], \"\"objects\"\": {\"\"line\"\": {\"\"type\"\": \"\"LineString\"\", \"\"arcs\"\": [0]}}}\"\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "array column: JSON forms",
    "specification": ["https://fairspec.org/specs/table-schema/#array"],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "array" } }
    },
    "tests": [
      {
        "description": "nested and mixed arrays are valid",
        "data": "id,x\n1,\"[[1, 2], [3]]\"\n2,\"[1, \"\"a\"\", null, true, {}]\"\n",
        "valid": true
      },
      {
        "description": "whitespace inside and around the JSON is valid",
        "data": "id,x\n1,[ ]\n2,\" [1, 2] \"\n",
        "valid": true
      },
      {
        "description": "JSON null is a cell/type error",
        "data": "id,x\n1,[]\n2,null\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "null"
          }
        ]
      },
      {
        "description": "a JSON number is a cell/type error",
        "data": "id,x\n1,[]\n2,1\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "1"
          }
        ]
      },
      {
        "description": "a JSON string is a cell/type error",
        "data": "id,x\n1,[]\n2,\"\"\"a\"\"\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "\"a\""
          }
        ]
      },
      {
        "description": "a trailing comma is a cell/type error",
        "data": "id,x\n1,[]\n2,\"[1, 2,]\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "[1, 2,]"
          }
        ]
      },
      {
        "description": "single quotes are a cell/type error",
        "data": "id,x\n1,[]\n2,['a']\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "['a']"
          }
        ]
      },
      {
        "description": "two arrays are a cell/type error",
        "data": "id,x\n1,[]\n2,[1] [2]\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 2,
            "cell": "[1] [2]"
          }
        ]
      }
    ]
  },
  {
    "description": "object column: JSON forms",
    "specification": ["https://fairspec.org/specs/table-schema/#object"],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "object" } }
    },
    "tests": [
      {
        "description": "nested objects are valid",
        "data": "id,x\n1,\"{\"\"a\"\": {\"\"b\"\": {\"\"c\"\": [1]}}}\"\n",
        "valid": true
      },
      {
        "description": "whitespace inside and around the JSON is valid",
        "data": "id,x\n1,{ }\n2,\" {\"\"a\"\": 1} \"\n",
        "valid": true
      },
      {
        "description": "JSON null is a cell/type error",
        "data": "id,x\n1,{}\n2,null\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "null"
          }
        ]
      },
      {
        "description": "a JSON boolean is a cell/type error",
        "data": "id,x\n1,{}\n2,true\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "true"
          }
        ]
      },
      {
        "description": "an unquoted key is a cell/type error",
        "data": "id,x\n1,{}\n2,{a: 1}\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "{a: 1}"
          }
        ]
      },
      {
        "description": "an unclosed object is a cell/type error",
        "data": "id,x\n1,{}\n2,\"{\"\"a\"\": 1\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "{\"a\": 1"
          }
        ]
      }
    ]
  },
  {
    "description": "object column: deep error pointers",
    "specification": [
      "https://fairspec.org/specs/table-schema/#jsonschema",
      "https://fairspec.org/specs/file-dialect/#jsonpointer"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "object",
          "properties": {
            "a": {
              "type": "object",
              "properties": { "b": { "type": "array", "items": { "type": "integer" } } }
            }
          }
        }
      }
    },
    "tests": [
      {
        "description": "a conforming nested value is valid",
        "data": "id,x\n1,\"{\"\"a\"\": {\"\"b\"\": [1, 2]}}\"\n",
        "valid": true
      },
      {
        "description": "a nested array item is reported at its full pointer",
        "data": "id,x\n1,\"{\"\"a\"\": {\"\"b\"\": [1]}}\"\n2,\"{\"\"a\"\": {\"\"b\"\": [1, \"\"x\"\"]}}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/json",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "{\"a\": {\"b\": [1, \"x\"]}}",
            "jsonPointer": "/a/b/1"
          }
        ]
      }
    ]
  },
  {
    "description": "object column: pointers to keys with a slash or a tilde",
    "specification": [
      "https://fairspec.org/specs/table-schema/#jsonschema",
      "https://fairspec.org/specs/file-dialect/#jsonpointer"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "object",
          "properties": { "a/b": { "type": "integer" }, "m~n": { "type": "integer" } }
        }
      }
    },
    "tests": [
      {
        "description": "a slash in a key is written ~1",
        "data": "id,x\n1,{}\n2,\"{\"\"a/b\"\": \"\"x\"\"}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/json",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "{\"a/b\": \"x\"}",
            "jsonPointer": "/a~1b"
          }
        ]
      },
      {
        "description": "a tilde in a key is written ~0",
        "data": "id,x\n1,{}\n2,\"{\"\"m~n\"\": \"\"x\"\"}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/json",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "{\"m~n\": \"x\"}",
            "jsonPointer": "/m~0n"
          }
        ]
      }
    ]
  },
  {
    "description": "array column: pointers into nested arrays",
    "specification": ["https://fairspec.org/specs/table-schema/#jsonschema"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tests": [
      {
        "description": "arrays of string arrays are valid",
        "data": "id,x\n1,\"[[\"\"a\"\"], [\"\"b\"\", \"\"c\"\"]]\"\n",
        "valid": true
      },
      {
        "description": "an inner item is reported at both indexes",
        "data": "id,x\n1,[]\n2,\"[[\"\"a\"\"], [\"\"b\"\", 1]]\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/json",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "[[\"a\"], [\"b\", 1]]",
            "jsonPointer": "/1/1"
          }
        ]
      }
    ]
  },
  {
    "description": "geojson column: geometry objects",
    "comment": "GeoJSON as RFC 7946: a position has two or more numbers, a LineString two or more positions",
    "specification": ["https://fairspec.org/specs/table-schema/#geojson"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "object", "format": "geojson" }
      }
    },
    "tests": [
      {
        "description": "multi-geometries are valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"MultiPoint\"\", \"\"coordinates\"\": [[1, 2], [3, 4]]}\"\n2,\"{\"\"type\"\": \"\"MultiLineString\"\", \"\"coordinates\"\": [[[1, 2], [3, 4]]]}\"\n3,\"{\"\"type\"\": \"\"MultiPolygon\"\", \"\"coordinates\"\": [[[[0, 0], [1, 0], [1, 1], [0, 0]]]]}\"\n",
        "valid": true
      },
      {
        "description": "a geometry collection is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"GeometryCollection\"\", \"\"geometries\"\": [{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}]}\"\n",
        "valid": true
      },
      {
        "description": "a lowercase type is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"point\"\", \"\"coordinates\"\": [1, 2]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"point\", \"coordinates\": [1, 2]}"
          }
        ]
      },
      {
        "description": "a point without coordinates is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"Point\"\"}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Point\"}"
          }
        ]
      },
      {
        "description": "a position with one number is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Point\", \"coordinates\": [1]}"
          }
        ]
      },
      {
        "description": "string coordinates are a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [\"\"1\"\", \"\"2\"\"]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Point\", \"coordinates\": [\"1\", \"2\"]}"
          }
        ]
      },
      {
        "description": "a line of one position is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"LineString\"\", \"\"coordinates\"\": [[1, 2]]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"LineString\", \"coordinates\": [[1, 2]]}"
          }
        ]
      },
      {
        "description": "a position with altitude is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2, 3]}\"\n",
        "valid": true
      }
    ]
  },
  {
    "description": "geojson column: objects that are not geometries",
    "comment": "A GeoJSON column holds GeoJSON geometry objects",
    "specification": ["https://fairspec.org/specs/table-schema/#geojson"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "object", "format": "geojson" }
      }
    },
    "tests": [
      {
        "description": "an object without a type is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"coordinates\"\": [1, 2]}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"coordinates\": [1, 2]}"
          }
        ]
      },
      {
        "description": "a Feature is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"Feature\"\", \"\"geometry\"\": {\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}, \"\"properties\"\": {}}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Feature\", \"geometry\": {\"type\": \"Point\", \"coordinates\": [1, 2]}, \"properties\": {}}"
          }
        ]
      },
      {
        "description": "a FeatureCollection is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [1, 2]}\"\n2,\"{\"\"type\"\": \"\"FeatureCollection\"\", \"\"features\"\": []}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "geojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"FeatureCollection\", \"features\": []}"
          }
        ]
      }
    ]
  },
  {
    "description": "topojson column: topologies",
    "specification": ["https://fairspec.org/specs/table-schema/#topojson"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "object", "format": "topojson" }
      }
    },
    "tests": [
      {
        "description": "a topology with a transform is valid",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"transform\"\": {\"\"scale\"\": [1, 1], \"\"translate\"\": [0, 0]}, \"\"objects\"\": {\"\"p\"\": {\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [0, 0]}}, \"\"arcs\"\": []}\"\n",
        "valid": true
      },
      {
        "description": "a topology without objects is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": [], \"\"objects\"\": {\"\"p\"\": {\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [0, 0]}}}\"\n2,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": []}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "topojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Topology\", \"arcs\": []}"
          }
        ]
      },
      {
        "description": "a GeoJSON Feature is a cell/type error",
        "data": "id,x\n1,\"{\"\"type\"\": \"\"Topology\"\", \"\"arcs\"\": [], \"\"objects\"\": {\"\"p\"\": {\"\"type\"\": \"\"Point\"\", \"\"coordinates\"\": [0, 0]}}}\"\n2,\"{\"\"type\"\": \"\"Feature\"\", \"\"geometry\"\": null, \"\"properties\"\": {}}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "topojson",
            "rowNumber": 2,
            "cell": "{\"type\": \"Feature\", \"geometry\": null, \"properties\": {}}"
          }
        ]
      }
    ]
  },
  {
    "description": "object column: values JSON does not allow",
    "comment": "RFC 8259 has no NaN or Infinity, though some parsers accept them",
    "specification": [
      "https://fairspec.org/specs/table-schema/#object",
      "https://www.rfc-editor.org/rfc/rfc8259"
    ],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "x": { "type": "object" } }
    },
    "tests": [
      {
        "description": "NaN is a cell/type error",
        "data": "id,x\n1,{}\n2,\"{\"\"a\"\": NaN}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "{\"a\": NaN}"
          }
        ]
      },
      {
        "description": "Infinity is a cell/type error",
        "data": "id,x\n1,{}\n2,\"{\"\"a\"\": Infinity}\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "object",
            "rowNumber": 2,
            "cell": "{\"a\": Infinity}"
          }
        ]
      }
    ]
  },
  {
    "description": "array column with only annotations",
    "comment": "Annotation keywords never fail a value, so only the JSON type and missing cells are checked",
    "specification": ["https://fairspec.org/specs/table-schema/#array"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "array",
          "title": "Tags",
          "description": "Free tags",
          "examples": [["a"]]
        }
      }
    },
    "tests": [
      {
        "description": "JSON arrays are valid",
        "data": "id,x\n1,\"[1, 2]\"\n2,[]\n",
        "valid": true
      },
      {
        "description": "each bad cell is reported in row order",
        "data": "id,x\n1,{}\n2,[]\n3,\n4,nope\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 1,
            "cell": "{}"
          },
          { "type": "cell/missing", "columnName": "x", "rowNumber": 3, "cell": "" },
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "array",
            "rowNumber": 4,
            "cell": "nope"
          }
        ]
      }
    ]
  }
]
