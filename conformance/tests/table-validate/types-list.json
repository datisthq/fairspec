[
  {
    "description": "list column",
    "specification": ["https://fairspec.org/specs/table-schema/#list"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list"
        }
      }
    },
    "tests": [
      {
        "description": "comma-delimited items are valid",
        "data": "id,x\n1,\"a,b,c\"\n2,single\n",
        "valid": true
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,\"a,b\"\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable list column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#list"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "list"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,\"a,b\"\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "list column of integers",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer"
        }
      }
    },
    "tests": [
      {
        "description": "integer items are valid",
        "data": "id,x\n1,\"1,2,3\"\n2,4\n",
        "valid": true
      },
      {
        "description": "a word item is a cell/type error",
        "data": "id,x\n1,\"1,2\"\n2,\"1,x\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,x"
          }
        ]
      },
      {
        "description": "a decimal item is a cell/type error",
        "data": "id,x\n1,\"1,2\"\n2,\"1,2.5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,2.5"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of numbers",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "number"
        }
      }
    },
    "tests": [
      {
        "description": "number items are valid",
        "data": "id,x\n1,\"1.5,2.3,4\"\n",
        "valid": true
      },
      {
        "description": "a word item is a cell/type error",
        "data": "id,x\n1,\"1.5,2\"\n2,\"1.5,abc\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1.5,abc"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of booleans",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "boolean"
        }
      }
    },
    "tests": [
      {
        "description": "boolean items are valid",
        "data": "id,x\n1,\"true,false\"\n",
        "valid": true
      },
      {
        "description": "a word item is a cell/type error",
        "data": "id,x\n1,\"true,false\"\n2,\"true,maybe\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "true,maybe"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of dates",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "date"
        }
      }
    },
    "tests": [
      {
        "description": "date items are valid",
        "data": "id,x\n1,\"2024-01-15,2024-02-20\"\n",
        "valid": true
      },
      {
        "description": "a word item is a cell/type error",
        "data": "id,x\n1,\"2024-01-15,2024-02-20\"\n2,\"2024-01-15,yesterday\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15,yesterday"
          }
        ]
      }
    ]
  },
  {
    "description": "list column with a delimiter",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#delimiter",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer",
          "delimiter": ";"
        }
      }
    },
    "tests": [
      {
        "description": "semicolon-delimited integers are valid",
        "data": "id,x\n1,1;2;3\n2,4\n",
        "valid": true
      },
      {
        "description": "comma-delimited integers are a cell/type error",
        "data": "id,x\n1,1;2\n2,\"1,2\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,2"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of times",
    "specification": [
      "https://fairspec.org/specs/table-schema/#itemtype",
      "https://fairspec.org/specs/table-schema/#time"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "time" }
      }
    },
    "tests": [
      {
        "description": "time items with offsets are valid",
        "data": "id,x\n1,\"14:30:00Z,09:00:00+02:00\"\n",
        "valid": true
      },
      {
        "description": "an item without an offset is a cell/type error",
        "data": "id,x\n1,14:30:00Z\n2,\"14:30:00Z,09:00:00\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "14:30:00Z,09:00:00"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of local times",
    "specification": [
      "https://fairspec.org/specs/table-schema/#itemtype",
      "https://fairspec.org/specs/table-schema/#localtime"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "local-time" }
      }
    },
    "tests": [
      {
        "description": "local time items are valid",
        "data": "id,x\n1,\"14:30:00,09:00:00.5\"\n",
        "valid": true
      },
      {
        "description": "an item with an offset is a cell/type error",
        "data": "id,x\n1,14:30:00\n2,\"14:30:00,09:00:00Z\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "14:30:00,09:00:00Z"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of date-times",
    "specification": [
      "https://fairspec.org/specs/table-schema/#itemtype",
      "https://fairspec.org/specs/table-schema/#datetime"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "date-time" }
      }
    },
    "tests": [
      {
        "description": "date-time items are valid",
        "data": "id,x\n1,\"2024-01-15T14:30:00Z,2024-01-16T09:00:00-05:00\"\n",
        "valid": true
      },
      {
        "description": "an item without an offset is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,\"2024-01-15T14:30:00Z,2024-01-16T09:00:00\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30:00Z,2024-01-16T09:00:00"
          }
        ]
      },
      {
        "description": "a bare date item is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,\"2024-01-15T14:30:00Z,2024-01-16\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30:00Z,2024-01-16"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of local date-times",
    "specification": [
      "https://fairspec.org/specs/table-schema/#itemtype",
      "https://fairspec.org/specs/table-schema/#localdatetime"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "local-date-time" }
      }
    },
    "tests": [
      {
        "description": "local date-time items are valid",
        "data": "id,x\n1,\"2024-01-15T14:30:00,2024-01-16T09:00:00\"\n",
        "valid": true
      },
      {
        "description": "an item with an offset is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00\n2,\"2024-01-15T14:30:00,2024-01-16T09:00:00Z\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30:00,2024-01-16T09:00:00Z"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of dates with an invalid calendar date",
    "specification": [
      "https://fairspec.org/specs/table-schema/#itemtype",
      "https://fairspec.org/specs/table-schema/#date"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "date" }
      }
    },
    "tests": [
      {
        "description": "February 30 is a cell/type error",
        "data": "id,x\n1,2024-01-15\n2,\"2024-01-15,2024-02-30\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15,2024-02-30"
          }
        ]
      },
      {
        "description": "an unpadded date is a cell/type error",
        "data": "id,x\n1,2024-01-15\n2,\"2024-01-15,2024-1-5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15,2024-1-5"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of booleans with the default values",
    "specification": [
      "https://fairspec.org/specs/table-schema/#itemtype",
      "https://fairspec.org/specs/table-schema/#truevalues",
      "https://fairspec.org/specs/table-schema/#falsevalues"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "boolean" }
      }
    },
    "tests": [
      {
        "description": "every default true and false value is valid",
        "data": "id,x\n1,\"True,FALSE,1,0\"\n",
        "valid": true
      },
      {
        "description": "yes is a cell/type error",
        "data": "id,x\n1,true\n2,\"true,yes\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "true,yes"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of one item",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "list", "itemType": "integer" }
      }
    },
    "tests": [
      {
        "description": "a single integer is a list of one",
        "data": "id,x\n1,5\n2,-7\n",
        "valid": true
      },
      {
        "description": "a single word is a cell/type error",
        "data": "id,x\n1,5\n2,x\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "x"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of numbers with a semicolon delimiter",
    "specification": [
      "https://fairspec.org/specs/table-schema/#delimiter",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "number",
          "delimiter": ";"
        }
      }
    },
    "tests": [
      {
        "description": "decimal points stay inside the items",
        "data": "id,x\n1,1.5;2.25;-3\n",
        "valid": true
      }
    ]
  },
  {
    "description": "list column with a pipe delimiter",
    "comment": "A delimiter that is special in a regular expression is still a literal character",
    "specification": ["https://fairspec.org/specs/table-schema/#delimiter"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer",
          "delimiter": "|"
        }
      }
    },
    "tests": [
      {
        "description": "pipe-delimited integers are valid",
        "data": "id,x\n1,1|2|3\n2,4\n",
        "valid": true
      },
      {
        "description": "a comma inside is a cell/type error",
        "data": "id,x\n1,1|2\n2,\"1,2|3\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,2|3"
          }
        ]
      }
    ]
  },
  {
    "description": "list column with a dot delimiter",
    "comment": "A delimiter that is special in a regular expression is still a literal character",
    "specification": ["https://fairspec.org/specs/table-schema/#delimiter"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer",
          "delimiter": "."
        }
      }
    },
    "tests": [
      {
        "description": "dot-delimited integers are valid",
        "data": "id,x\n1,1.2.3\n2,10.20\n",
        "valid": true
      },
      {
        "description": "a word item is a cell/type error",
        "data": "id,x\n1,1.2\n2,1.x\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1.x"
          }
        ]
      }
    ]
  },
  {
    "description": "list column with an asterisk delimiter",
    "specification": ["https://fairspec.org/specs/table-schema/#delimiter"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer",
          "delimiter": "*"
        }
      }
    },
    "tests": [
      {
        "description": "asterisk-delimited integers are valid",
        "data": "id,x\n1,1*2*3\n",
        "valid": true
      }
    ]
  },
  {
    "description": "list column: a literal split",
    "specification": ["https://fairspec.org/specs/table-schema/#list"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer"
        }
      }
    },
    "tests": [
      {
        "description": "items in the integer grammar are valid",
        "data": "id,x\n1,\"1,2.0,-0\"\n",
        "valid": true
      },
      {
        "description": "an empty item between delimiters is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,,2\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,,2"
          }
        ]
      },
      {
        "description": "a trailing delimiter is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,2,\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,2,"
          }
        ]
      },
      {
        "description": "a leading delimiter is a cell/type error",
        "data": "id,x\n1,1\n2,\",1\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": ",1"
          }
        ]
      },
      {
        "description": "an item with a leading space is a cell/type error",
        "data": "id,x\n1,1\n2,\"1, 2\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1, 2"
          }
        ]
      },
      {
        "description": "an item with a plus sign is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,+2\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,+2"
          }
        ]
      },
      {
        "description": "an item with leading zeros is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,02\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,02"
          }
        ]
      }
    ]
  },
  {
    "description": "list column: empty items are counted",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#minitems"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "minItems": 3
        }
      }
    },
    "tests": [
      {
        "description": "empty items count as items",
        "data": "id,x\n1,\"a,,b\"\n2,\"a,b,\"\n3,\",,\"\n",
        "valid": true
      },
      {
        "description": "two items are a cell/minItems error",
        "data": "id,x\n1,\"a,,b\"\n2,\"a,b\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/minItems",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "a,b",
            "minItems": 3
          }
        ]
      }
    ]
  },
  {
    "description": "list column: an empty cell is an empty list",
    "specification": ["https://fairspec.org/specs/table-schema/#list"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "integer"
        }
      }
    },
    "tests": [
      {
        "description": "a quoted empty cell is valid",
        "data": "id,x\n1,\"1,2\"\n2,\"\"\n",
        "valid": true
      },
      {
        "description": "an unquoted empty cell is a cell/missing error",
        "data": "id,x\n1,\"1,2\"\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "list column: an empty list has no items",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#minitems"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "minItems": 1
        }
      }
    },
    "tests": [
      {
        "description": "a quoted empty cell is a cell/minItems error",
        "data": "id,x\n1,a\n2,\"\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/minItems",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "",
            "minItems": 1
          }
        ]
      }
    ]
  },
  {
    "description": "list column: length keywords on the whole text",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#minlength",
      "https://fairspec.org/specs/table-schema/#maxlength"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "minLength": 3,
          "maxLength": 3
        }
      }
    },
    "tests": [
      {
        "description": "text of three characters is valid",
        "data": "id,x\n1,\"a,b\"\n2,abc\n",
        "valid": true
      },
      {
        "description": "the delimiters count toward the length",
        "data": "id,x\n1,\"a,b\"\n2,\"a,bc\"\n3,ab\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/maxLength",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "a,bc",
            "maxLength": 3
          },
          {
            "type": "cell/minLength",
            "columnName": "x",
            "rowNumber": 3,
            "cell": "ab",
            "minLength": 3
          }
        ]
      }
    ]
  },
  {
    "description": "list column: a pattern on the whole text",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#pattern"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "pattern": "^a,b$"
        }
      }
    },
    "tests": [
      {
        "description": "the whole text matching is valid",
        "data": "id,x\n1,\"a,b\"\n",
        "valid": true
      },
      {
        "description": "an item alone does not match",
        "data": "id,x\n1,\"a,b\"\n2,a\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/pattern",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "a",
            "pattern": "^a,b$"
          }
        ]
      }
    ]
  },
  {
    "description": "list column: missing values match the whole cell",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#missingvalues"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "list",
          "itemType": "integer"
        }
      },
      "missingValues": ["NA"]
    },
    "tests": [
      {
        "description": "the whole cell is missing",
        "data": "id,x\n1,NA\n2,\"1,2\"\n",
        "valid": true
      },
      {
        "description": "a missing value as an item is a cell/type error",
        "data": "id,x\n1,\"1,2\"\n2,\"1,NA\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,NA"
          }
        ]
      }
    ]
  },
  {
    "description": "list column: a missing value as an item is counted",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#missingvalues",
      "https://fairspec.org/specs/table-schema/#maxitems"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "list",
          "maxItems": 1
        }
      },
      "missingValues": ["NA"]
    },
    "tests": [
      {
        "description": "an item equal to a missing value is an item",
        "data": "id,x\n1,NA\n2,\"a,NA\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/maxItems",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "a,NA",
            "maxItems": 1
          }
        ]
      }
    ]
  },
  {
    "description": "list column of booleans: items match exactly",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#truevalues"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "boolean"
        }
      }
    },
    "tests": [
      {
        "description": "an item with a leading space is a cell/type error",
        "data": "id,x\n1,true\n2,\"true, false\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "true, false"
          }
        ]
      },
      {
        "description": "an item with leading zeros is a cell/type error",
        "data": "id,x\n1,true\n2,\"true,01\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "true,01"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of numbers: items in the JSON number grammar",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#number"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "number"
        }
      }
    },
    "tests": [
      {
        "description": "numbers in the grammar are valid",
        "data": "id,x\n1,\"0.5,-2,1E-3\"\n",
        "valid": true
      },
      {
        "description": "a fraction without an integer part is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,.5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,.5"
          }
        ]
      },
      {
        "description": "NaN is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,NaN\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,NaN"
          }
        ]
      },
      {
        "description": "a plus sign is a cell/type error",
        "data": "id,x\n1,1\n2,\"1,+2\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "1,+2"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of date-times: RFC 3339 defaults",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#temporalformat"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "date-time",
          "delimiter": ";"
        }
      }
    },
    "tests": [
      {
        "description": "lowercase t and z, a leap second and the year 0000 are valid",
        "data": "id,x\n1,\"2024-01-15t12:00:00z;2016-12-31T23:59:60Z;0000-01-01T00:00:00Z\"\n",
        "valid": true
      },
      {
        "description": "an offset without a colon is a cell/type error",
        "data": "id,x\n1,2024-01-15t12:00:00z\n2,\"2024-01-15T12:00:00Z;2024-01-15T12:00:00+0200\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T12:00:00Z;2024-01-15T12:00:00+0200"
          }
        ]
      },
      {
        "description": "a space separator is a cell/type error",
        "data": "id,x\n1,2024-01-15t12:00:00z\n2,\"2024-01-15T12:00:00Z;2024-01-15 12:00:00Z\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T12:00:00Z;2024-01-15 12:00:00Z"
          }
        ]
      },
      {
        "description": "a leap second at another minute is a cell/type error",
        "data": "id,x\n1,2024-01-15t12:00:00z\n2,\"2024-01-15T12:00:00Z;2016-12-31T12:30:60Z\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T12:00:00Z;2016-12-31T12:30:60Z"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of times: RFC 3339 defaults",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#temporalformat"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "time",
          "delimiter": ";"
        }
      }
    },
    "tests": [
      {
        "description": "a lowercase z and a leap second are valid",
        "data": "id,x\n1,\"12:00:00z;23:59:60Z;15:59:60-08:00\"\n",
        "valid": true
      },
      {
        "description": "an offset of hours only is a cell/type error",
        "data": "id,x\n1,12:00:00z\n2,\"12:00:00Z;12:00:00+02\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "12:00:00Z;12:00:00+02"
          }
        ]
      },
      {
        "description": "a leap second at another minute is a cell/type error",
        "data": "id,x\n1,12:00:00z\n2,\"12:00:00Z;12:30:60Z\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "12:00:00Z;12:30:60Z"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of local times: RFC 3339 defaults",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#temporalformat"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "local-time",
          "delimiter": ";"
        }
      }
    },
    "tests": [
      {
        "description": "a leap second at 23:59:60 is valid",
        "data": "id,x\n1,\"12:00:00;23:59:60\"\n",
        "valid": true
      },
      {
        "description": "a leap second at another minute is a cell/type error",
        "data": "id,x\n1,12:00:00\n2,\"12:00:00;12:30:60\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "12:00:00;12:30:60"
          }
        ]
      },
      {
        "description": "hour 24 is a cell/type error",
        "data": "id,x\n1,12:00:00\n2,\"12:00:00;24:00:00\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "12:00:00;24:00:00"
          }
        ]
      }
    ]
  },
  {
    "description": "list column of local date-times: RFC 3339 defaults",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#temporalformat"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "list",
          "itemType": "local-date-time",
          "delimiter": ";"
        }
      }
    },
    "tests": [
      {
        "description": "a lowercase t and a leap second are valid",
        "data": "id,x\n1,\"2024-01-15t12:00:00;2016-12-31T23:59:60\"\n",
        "valid": true
      },
      {
        "description": "a space separator is a cell/type error",
        "data": "id,x\n1,2024-01-15t12:00:00\n2,\"2024-01-15T12:00:00;2024-01-15 12:00:00\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "list",
            "rowNumber": 2,
            "cell": "2024-01-15T12:00:00;2024-01-15 12:00:00"
          }
        ]
      }
    ]
  }
