[
  {
    "description": "plain categories on a string column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#categories"
    ],
    "tableSchema": {
      "properties": {
        "size": {
          "type": "string",
          "format": "categorical",
          "categories": ["S", "M", "L"]
        }
      }
    },
    "tests": [
      {
        "description": "listed categories are valid",
        "data": "size\nS\nL\nM\n",
        "valid": true
      },
      {
        "description": "an unlisted category is an error",
        "data": "size\nS\nXL\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "size",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "XL"
          }
        ]
      }
    ]
  },
  {
    "description": "labelled categories on an integer column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#categories"
    ],
    "tableSchema": {
      "properties": {
        "severity": {
          "type": "integer",
          "format": "categorical",
          "categories": [
            {
              "value": 1,
              "label": "Low"
            },
            {
              "value": 2,
              "label": "Medium"
            },
            {
              "value": 3,
              "label": "High"
            }
          ]
        }
      }
    },
    "tests": [
      {
        "description": "category values are valid",
        "data": "severity\n1\n3\n2\n",
        "valid": true
      },
      {
        "description": "a label is not a value",
        "data": "severity\n1\nLow\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "severity",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "Low"
          }
        ]
      },
      {
        "description": "an unlisted value is an error",
        "data": "severity\n1\n4\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "severity",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "4"
          }
        ]
      }
    ]
  },
  {
    "description": "string categories match exactly",
    "specification": ["https://fairspec.org/specs/table-schema/#categories"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "categorical",
          "categories": ["low", "high"]
        }
      }
    },
    "tests": [
      {
        "description": "another case is a cell/type error",
        "data": "id,x\n1,low\n2,Low\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "Low"
          }
        ]
      },
      {
        "description": "a leading space is a cell/type error",
        "data": "id,x\n1,low\n2, low\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": " low"
          }
        ]
      },
      {
        "description": "a trailing space is a cell/type error",
        "data": "id,x\n1,low\n2,low \n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "low "
          }
        ]
      }
    ]
  },
  {
    "description": "ordered categories",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categories",
      "https://fairspec.org/specs/table-schema/#withorder"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "categorical",
          "withOrder": true,
          "categories": [
            { "value": "S", "label": "Small" },
            { "value": "M", "label": "Medium" },
            { "value": "L", "label": "Large" }
          ]
        }
      }
    },
    "tests": [
      {
        "description": "listed values in any order are valid",
        "data": "id,x\n1,L\n2,S\n3,M\n4,S\n",
        "valid": true
      },
      {
        "description": "an unlisted value is a cell/type error",
        "data": "id,x\n1,S\n2,XL\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "XL"
          }
        ]
      },
      {
        "description": "a label is a cell/type error",
        "data": "id,x\n1,S\n2,Small\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "Small"
          }
        ]
      }
    ]
  },
  {
    "description": "ordered integer categories",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categories",
      "https://fairspec.org/specs/table-schema/#withorder"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "integer",
          "format": "categorical",
          "withOrder": true,
          "categories": [3, 1, 2]
        }
      }
    },
    "tests": [
      {
        "description": "listed values are valid",
        "data": "id,x\n1,1\n2,2\n3,3\n",
        "valid": true
      },
      {
        "description": "an unlisted value is a cell/type error",
        "data": "id,x\n1,1\n2,0\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "0"
          }
        ]
      },
      {
        "description": "a negative unlisted value is a cell/type error",
        "data": "id,x\n1,1\n2,-1\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "-1"
          }
        ]
      }
    ]
  },
  {
    "description": "maxLength on a string categorical column",
    "comment": "A string categorical column supports the string type properties",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#maxlength"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "categorical",
          "categories": ["a", "bb"],
          "maxLength": 1
        }
      }
    },
    "tests": [
      {
        "description": "a listed category within the length is valid",
        "data": "id,x\n1,a\n",
        "valid": true
      },
      {
        "description": "a listed category too long is a cell/maxLength error",
        "data": "id,x\n1,a\n2,bb\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/maxLength",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "bb",
            "maxLength": 1
          }
        ]
      }
    ]
  },
  {
    "description": "pattern on a string categorical column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#pattern"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "categorical",
          "categories": ["a1", "b2"],
          "pattern": "^a"
        }
      }
    },
    "tests": [
      {
        "description": "a listed category matching the pattern is valid",
        "data": "id,x\n1,a1\n",
        "valid": true
      },
      {
        "description": "a listed category not matching is a cell/pattern error",
        "data": "id,x\n1,a1\n2,b2\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/pattern",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "b2",
            "pattern": "^a"
          }
        ]
      }
    ]
  },
  {
    "description": "minimum and maximum on an integer categorical column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#minimum",
      "https://fairspec.org/specs/table-schema/#maximum"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "integer",
          "format": "categorical",
          "categories": [1, 2, 3, 4, 5, 6],
          "minimum": 2,
          "maximum": 5
        }
      }
    },
    "tests": [
      {
        "description": "listed categories within the bounds are valid",
        "data": "id,x\n1,2\n2,5\n",
        "valid": true
      },
      {
        "description": "listed categories past the bounds are errors",
        "data": "id,x\n1,1\n2,3\n3,6\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/minimum",
            "columnName": "x",
            "rowNumber": 1,
            "cell": "1",
            "minimum": "2"
          },
          {
            "type": "cell/maximum",
            "columnName": "x",
            "rowNumber": 3,
            "cell": "6",
            "maximum": "5"
          }
        ]
      },
      {
        "description": "an unlisted value is a cell/type error only",
        "data": "id,x\n1,2\n2,7\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "categorical",
            "rowNumber": 2,
            "cell": "7"
          }
        ]
      }
    ]
  },
  {
    "description": "exclusive bounds on an integer categorical column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#exclusiveminimum",
      "https://fairspec.org/specs/table-schema/#exclusivemaximum"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "integer",
          "format": "categorical",
          "categories": [1, 2, 3, 4],
          "exclusiveMinimum": 1,
          "exclusiveMaximum": 4
        }
      }
    },
    "tests": [
      {
        "description": "listed categories strictly inside are valid",
        "data": "id,x\n1,2\n2,3\n",
        "valid": true
      },
      {
        "description": "listed categories on the bounds are errors",
        "data": "id,x\n1,1\n2,2\n3,4\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/exclusiveMinimum",
            "columnName": "x",
            "rowNumber": 1,
            "cell": "1",
            "minimum": "1"
          },
          {
            "type": "cell/exclusiveMaximum",
            "columnName": "x",
            "rowNumber": 3,
            "cell": "4",
            "maximum": "4"
          }
        ]
      }
    ]
  },
  {
    "description": "multipleOf on an integer categorical column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#multipleof"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "integer",
          "format": "categorical",
          "categories": [1, 2, 3, 4],
          "multipleOf": 2
        }
      }
    },
    "tests": [
      {
        "description": "listed multiples are valid",
        "data": "id,x\n1,2\n2,4\n",
        "valid": true
      },
      {
        "description": "a listed non-multiple is a cell/multipleOf error",
        "data": "id,x\n1,2\n2,3\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/multipleOf",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "3",
            "multipleOf": 2
          }
        ]
      }
    ]
  },
  {
    "description": "minLength on a string categorical column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#categorical",
      "https://fairspec.org/specs/table-schema/#minlength"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "categorical",
          "categories": ["a", "bb"],
          "minLength": 2
        }
      }
    },
    "tests": [
      {
        "description": "a listed category long enough is valid",
        "data": "id,x\n1,bb\n",
        "valid": true
      },
      {
        "description": "a listed category too short is a cell/minLength error",
        "data": "id,x\n1,bb\n2,a\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/minLength",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "a",
            "minLength": 2
          }
        ]
      }
    ]
  }
]
