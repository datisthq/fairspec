[
  {
    "description": "temporalFormat on a date column",
    "comment": "A declared dialect, since the sniffer takes the slash of a single-column file as its delimiter",
    "fileDialect": { "format": "csv" },
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "collected": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%m/%d/%Y"
        }
      }
    },
    "tests": [
      {
        "description": "dates in the format are valid",
        "data": "collected\n01/15/2024\n12/31/2023\n",
        "valid": true
      },
      {
        "description": "an ISO date is a cell/type error",
        "data": "collected\n01/15/2024\n2024-01-15\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "collected",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-01-15"
          }
        ]
      }
    ]
  },
  {
    "description": "temporalFormat on a local-time column",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "start": {
          "type": "string",
          "format": "local-time",
          "temporalFormat": "%H.%M"
        }
      }
    },
    "tests": [
      {
        "description": "times in the format are valid",
        "data": "start\n14.30\n09.05\n",
        "valid": true
      },
      {
        "description": "an ISO time is a cell/type error",
        "data": "start\n14:30:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "start",
            "columnType": "local-time",
            "rowNumber": 1,
            "cell": "14:30:00"
          }
        ]
      }
    ]
  },
  {
    "description": "temporalFormat on a local-date-time column",
    "comment": "A declared dialect, since the sniffer takes the slash of a single-column file as its delimiter",
    "fileDialect": { "format": "csv" },
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "seen": {
          "type": "string",
          "format": "local-date-time",
          "temporalFormat": "%d/%m/%Y %H:%M"
        }
      }
    },
    "tests": [
      {
        "description": "date-times in the format are valid",
        "data": "seen\n15/01/2024 14:30\n",
        "valid": true
      },
      {
        "description": "an ISO date-time is a cell/type error",
        "data": "seen\n2024-01-15T14:30:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "seen",
            "columnType": "local-date-time",
            "rowNumber": 1,
            "cell": "2024-01-15T14:30:00"
          }
        ]
      }
    ]
  },
  {
    "description": "numeric fields without leading zeros",
    "comment": "A declared dialect, since the sniffer takes the slash of a single-column file as its delimiter",
    "fileDialect": { "format": "csv" },
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%m/%d/%Y"
        }
      }
    },
    "tests": [
      {
        "description": "unpadded months and days are valid",
        "data": "v\n1/5/2024\n01/05/2024\n",
        "valid": true
      }
    ]
  },
  {
    "description": "month names",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%d %b %Y"
        }
      }
    },
    "tests": [
      {
        "description": "abbreviated names match regardless of case",
        "data": "v\n15 Jan 2024\n15 jan 2024\n15 JAN 2024\n",
        "valid": true
      },
      {
        "description": "a full name is a cell/type error under %b",
        "data": "v\n15 Jan 2024\n15 January 2024\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "v",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "15 January 2024"
          }
        ]
      }
    ]
  },
  {
    "description": "full month names",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%d %B %Y"
        }
      }
    },
    "tests": [
      {
        "description": "full and abbreviated names are valid",
        "data": "v\n15 January 2024\n15 Jan 2024\n",
        "valid": true
      }
    ]
  },
  {
    "description": "two-digit years",
    "comment": "A declared dialect, since the sniffer takes the slash of a single-column file as its delimiter",
    "fileDialect": { "format": "csv" },
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%d/%m/%y"
        }
      }
    },
    "tests": [
      {
        "description": "years within a century are valid",
        "data": "v\n15/01/24\n15/01/99\n",
        "valid": true
      }
    ]
  },
  {
    "description": "days of the year",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%Y-%j"
        }
      }
    },
    "tests": [
      {
        "description": "day 366 of a leap year is valid",
        "data": "v\n2024-032\n2024-366\n",
        "valid": true
      },
      {
        "description": "day 366 of a common year is a cell/type error",
        "data": "v\n2024-032\n2023-366\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "v",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2023-366"
          }
        ]
      }
    ]
  },
  {
    "description": "12-hour clock",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "local-time",
          "temporalFormat": "%I:%M %p"
        }
      }
    },
    "tests": [
      {
        "description": "AM and PM match regardless of case",
        "data": "v\n2:30 PM\n9:45 am\n",
        "valid": true
      }
    ]
  },
  {
    "description": "fractional seconds",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "local-time",
          "temporalFormat": "%H:%M:%S%.f"
        }
      }
    },
    "tests": [
      {
        "description": "fractions are optional",
        "data": "v\n14:30:00\n14:30:00.5\n14:30:00.123456\n",
        "valid": true
      }
    ]
  },
  {
    "description": "an offset with a colon",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date-time",
          "temporalFormat": "%Y-%m-%dT%H:%M%:z"
        }
      }
    },
    "tests": [
      {
        "description": "%:z also reads an offset without a colon",
        "data": "v\n2024-01-15T14:30+02:00\n2024-01-15T14:30+0200\n",
        "valid": true
      },
      {
        "description": "Z is a cell/type error under %:z",
        "data": "v\n2024-01-15T14:30+02:00\n2024-01-15T14:30Z\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "v",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30Z"
          }
        ]
      }
    ]
  },
  {
    "description": "a literal percent sign",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "v": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%d%%%m%%%Y"
        }
      }
    },
    "tests": [
      {
        "description": "%% matches a percent sign",
        "data": "v\n15%01%2024\n",
        "valid": true
      }
    ]
  },
  {
    "description": "12-hour clock bounds",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "local-time", "temporalFormat": "%I:%M %p" }
      }
    },
    "tests": [
      {
        "description": "12 and 1 are valid hours",
        "data": "id,x\n1,12:00 AM\n2,12:30 PM\n3,01:00 AM\n",
        "valid": true
      },
      {
        "description": "hour 13 is a cell/type error",
        "data": "id,x\n1,12:00 AM\n2,13:00 PM\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "13:00 PM"
          }
        ]
      },
      {
        "description": "hour 00 is a cell/type error",
        "data": "id,x\n1,12:00 AM\n2,00:30 AM\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "00:30 AM"
          }
        ]
      },
      {
        "description": "a missing AM or PM is a cell/type error",
        "data": "id,x\n1,12:00 AM\n2,12:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "12:00"
          }
        ]
      },
      {
        "description": "dotted A.M. is a cell/type error",
        "data": "id,x\n1,12:00 AM\n2,12:00 A.M.\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "12:00 A.M."
          }
        ]
      }
    ]
  },
  {
    "description": "two-digit years in the 2000s",
    "comment": "%y 00 is 2000, a leap year; read as 1900 it would not be one. A declared dialect, since the sniffer takes the slash of a single-column file as its delimiter",
    "fileDialect": { "format": "csv" },
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "date", "temporalFormat": "%d/%m/%y" }
      }
    },
    "tests": [
      {
        "description": "February 29 of 00 is valid since 00 is 2000",
        "data": "id,x\n1,29/02/00\n",
        "valid": true
      },
      {
        "description": "a four-digit year is a cell/type error",
        "data": "id,x\n1,15/01/24\n2,15/01/2024\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "15/01/2024"
          }
        ]
      }
    ]
  },
  {
    "description": "day of the year bounds",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "date", "temporalFormat": "%Y-%j" }
      }
    },
    "tests": [
      {
        "description": "day 001 and day 365 of a common year are valid",
        "data": "id,x\n1,2023-001\n2,2023-365\n",
        "valid": true
      },
      {
        "description": "day 000 is a cell/type error",
        "data": "id,x\n1,2023-001\n2,2023-000\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2023-000"
          }
        ]
      },
      {
        "description": "day 367 is a cell/type error",
        "data": "id,x\n1,2023-001\n2,2024-367\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-367"
          }
        ]
      }
    ]
  },
  {
    "description": "field ranges",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "local-date-time",
          "temporalFormat": "%Y-%m-%d %H:%M:%S"
        }
      }
    },
    "tests": [
      {
        "description": "the bounds of every field are valid",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2024-12-31 23:59:59\n",
        "valid": true
      },
      {
        "description": "unpadded fields are valid",
        "data": "id,x\n1,2024-1-5 9:5:7\n",
        "valid": true
      },
      {
        "description": "minute 60 is a cell/type error",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2024-01-01 00:60:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "2024-01-01 00:60:00"
          }
        ]
      },
      {
        "description": "hour 24 is a cell/type error",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2024-01-01 24:00:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "2024-01-01 24:00:00"
          }
        ]
      },
      {
        "description": "month 13 is a cell/type error",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2024-13-01 00:00:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "2024-13-01 00:00:00"
          }
        ]
      },
      {
        "description": "April 31 is a cell/type error",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2024-04-31 00:00:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "2024-04-31 00:00:00"
          }
        ]
      },
      {
        "description": "February 29 of a common year is a cell/type error",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2023-02-29 00:00:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "2023-02-29 00:00:00"
          }
        ]
      },
      {
        "description": "second 60 is a cell/type error",
        "data": "id,x\n1,2024-01-01 00:00:00\n2,2024-01-01 00:00:60\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "2024-01-01 00:00:60"
          }
        ]
      }
    ]
  },
  {
    "description": "literal text in a pattern",
    "comment": "A declared dialect, since the sniffer takes the slash of a single-column file as its delimiter",
    "fileDialect": { "format": "csv" },
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "date", "temporalFormat": "on %Y-%m-%d" }
      }
    },
    "tests": [
      {
        "description": "the literal text and the fields are valid",
        "data": "id,x\n1,on 2024-01-15\n",
        "valid": true
      },
      {
        "description": "a missing literal is a cell/type error",
        "data": "id,x\n1,on 2024-01-15\n2,2024-01-15\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-01-15"
          }
        ]
      },
      {
        "description": "another separator is a cell/type error",
        "data": "id,x\n1,on 2024-01-15\n2,on 2024/01/15\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "on 2024/01/15"
          }
        ]
      },
      {
        "description": "trailing text is a cell/type error",
        "data": "id,x\n1,on 2024-01-15\n2,on 2024-01-15 ok\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "on 2024-01-15 ok"
          }
        ]
      },
      {
        "description": "leading text is a cell/type error",
        "data": "id,x\n1,on 2024-01-15\n2,x on 2024-01-15\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "x on 2024-01-15"
          }
        ]
      }
    ]
  },
  {
    "description": "a percent sign next to a field",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "local-time", "temporalFormat": "%H%%%M" }
      }
    },
    "tests": [
      {
        "description": "a percent sign between fields is valid",
        "data": "id,x\n1,14%30\n",
        "valid": true
      },
      {
        "description": "a missing percent sign is a cell/type error",
        "data": "id,x\n1,14%30\n2,1430\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "1430"
          }
        ]
      }
    ]
  },
  {
    "description": "an offset without a colon",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "time", "temporalFormat": "%H:%M%z" }
      }
    },
    "tests": [
      {
        "description": "%z reads offsets with and without a colon",
        "data": "id,x\n1,14:30+0200\n2,14:30-05:30\n3,14:30+0000\n",
        "valid": true
      },
      {
        "description": "Z is a cell/type error under %z",
        "data": "id,x\n1,14:30+0200\n2,14:30Z\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "time",
            "rowNumber": 2,
            "cell": "14:30Z"
          }
        ]
      },
      {
        "description": "an offset of hours only is a cell/type error",
        "data": "id,x\n1,14:30+0200\n2,14:30+02\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "time",
            "rowNumber": 2,
            "cell": "14:30+02"
          }
        ]
      },
      {
        "description": "a missing offset is a cell/type error",
        "data": "id,x\n1,14:30+0200\n2,14:30\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "time",
            "rowNumber": 2,
            "cell": "14:30"
          }
        ]
      }
    ]
  },
  {
    "description": "fractional seconds need a digit",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": {
          "type": "string",
          "format": "local-time",
          "temporalFormat": "%H:%M:%S%.f"
        }
      }
    },
    "tests": [
      {
        "description": "a decimal point without digits is a cell/type error",
        "data": "id,x\n1,14:30:00\n2,14:30:00.\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "14:30:00."
          }
        ]
      },
      {
        "description": "a decimal comma is a cell/type error",
        "data": "id,x\n1,14:30:00\n2,\"14:30:00,5\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-time",
            "rowNumber": 2,
            "cell": "14:30:00,5"
          }
        ]
      }
    ]
  },
  {
    "description": "month names that are not English",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "date", "temporalFormat": "%d %B %Y" }
      }
    },
    "tests": [
      {
        "description": "a truncated name is a cell/type error",
        "data": "id,x\n1,15 January 2024\n2,15 Janu 2024\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "15 Janu 2024"
          }
        ]
      },
      {
        "description": "a French name is a cell/type error",
        "data": "id,x\n1,15 January 2024\n2,15 janvier 2024\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "15 janvier 2024"
          }
        ]
      }
    ]
  },
  {
    "description": "unpadded fields under the default form",
    "comment": "Without temporalFormat 2024-1-5 is invalid; with the same fields as a pattern, numeric fields match without leading zeros",
    "specification": [
      "https://fairspec.org/specs/table-schema/#temporalformat",
      "https://fairspec.org/specs/table-schema/#date"
    ],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "date", "temporalFormat": "%Y-%m-%d" }
      }
    },
    "tests": [
      {
        "description": "an unpadded month and day are valid with the pattern",
        "data": "id,x\n1,2024-1-5\n2,2024-01-05\n",
        "valid": true
      }
    ]
  },
  {
    "description": "fields written without separators",
    "comment": "%S is 00–59 also when no separator marks where the seconds start",
    "specification": ["https://fairspec.org/specs/table-schema/#temporalformat"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "local-date-time",
          "temporalFormat": "%Y%m%d%H%M%S"
        }
      }
    },
    "tests": [
      {
        "description": "a compact value is valid",
        "data": "id,x\n1,20240115103000\n",
        "valid": true
      },
      {
        "description": "second 60 is a cell/type error",
        "data": "id,x\n1,20240101000000\n2,20240101000060\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "local-date-time",
            "rowNumber": 2,
            "cell": "20240101000060"
          }
        ]
      }
    ]
  },
  {
    "description": "time fields in a date pattern",
    "comment": "A Date pattern may hold time fields; the value must still match the whole pattern",
    "specification": [
      "https://fairspec.org/specs/table-schema/#temporalformat",
      "https://fairspec.org/specs/table-schema/#date"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%Y-%m-%d %H:%M:%S"
        }
      }
    },
    "tests": [
      {
        "description": "a date with a time is valid",
        "data": "id,x\n1,2024-01-15 23:59:59\n",
        "valid": true
      },
      {
        "description": "second 60 is a cell/type error",
        "data": "id,x\n1,2024-01-15 00:00:00\n2,2024-01-15 23:59:60\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-01-15 23:59:60"
          }
        ]
      }
    ]
  }
