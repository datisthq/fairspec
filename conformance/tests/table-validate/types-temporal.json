  {
    "description": "duration column: forms",
    "specification": ["https://fairspec.org/specs/table-schema/#duration"],
    "tableSchema": {
      "properties": {
        "id": { "type": "integer" },
        "x": { "type": "string", "format": "duration" }
      }
    },
    "tests": [
      {
        "description": "every component together is valid",
        "data": "id,x\n1,P1Y2M3DT4H5M6S\n",
        "valid": true
      },
      {
        "description": "a single component is valid",
        "data": "id,x\n1,P1Y\n2,P1M\n3,P1D\n4,PT1H\n5,PT1M\n6,PT1S\n",
        "valid": true
      },
      {
        "description": "weeks are valid",
        "data": "id,x\n1,P1W\n2,P52W\n",
        "valid": true
      },
      {
        "description": "a component above its carry-over is valid",
        "data": "id,x\n1,PT36H\n2,PT90M\n",
        "valid": true
      },
      { "description": "zero is valid", "data": "id,x\n1,PT0S\n2,P0D\n", "valid": true },
      {
        "description": "hours without the time designator are a cell/type error",
        "data": "id,x\n1,P1D\n2,P1H\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "duration",
            "rowNumber": 2,
            "cell": "P1H"
          }
        ]
      },
      {
        "description": "days after the time designator are a cell/type error",
        "data": "id,x\n1,P1D\n2,PT1D\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "duration",
            "rowNumber": 2,
            "cell": "PT1D"
          }
        ]
      },
      {
        "description": "a missing period designator is a cell/type error",
        "data": "id,x\n1,P1D\n2,1D\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "duration",
            "rowNumber": 2,
            "cell": "1D"
          }
        ]
      },
      {
        "description": "components out of order are a cell/type error",
        "data": "id,x\n1,P1D\n2,P1D1Y\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "duration",
            "rowNumber": 2,
            "cell": "P1D1Y"
          }
        ]
      },
      {
        "description": "a component without a number is a cell/type error",
        "data": "id,x\n1,P1D\n2,PYD\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "duration",
            "rowNumber": 2,
            "cell": "PYD"
          }
        ]
      },
      {
        "description": "a time designator without components is a cell/type error",
