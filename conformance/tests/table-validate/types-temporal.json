    },
    "tests": [
      {
        "description": "times with an offset are valid",
        "data": "id,x\n1,14:30:00Z\n2,09:45:30+02:00\n3,18:00:00-05:00\n",
        "valid": true
      },
      {
        "description": "fractional seconds are valid",
        "data": "id,x\n1,18:00:00.5-05:00\n",
        "valid": true
      },
      {
        "description": "a time without an offset is a cell/type error",
        "data": "id,x\n1,14:30:00Z\n2,14:30:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "time",
            "rowNumber": 2,
            "cell": "14:30:00"
          }
        ]
      },
      {
        "description": "hour 25 is a cell/type error",
        "data": "id,x\n1,14:30:00Z\n2,25:00:00Z\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "time",
            "rowNumber": 2,
            "cell": "25:00:00Z"
          }
        ]
      },
      {
        "description": "a word is a cell/type error",
        "data": "id,x\n1,14:30:00Z\n2,noon\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "time",
            "rowNumber": 2,
            "cell": "noon"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,14:30:00Z\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
