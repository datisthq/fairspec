  {
    "description": "date-time column",
    "specification": ["https://fairspec.org/specs/table-schema/#datetime"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "tests": [
      {
        "description": "the spec's data example is valid",
        "data": "id,x\n1,2023-12-01T14:30:00Z\n2,2024-01-15T09:45:30+00:00\n3,2024-03-20T18:00:00-05:00\n",
        "valid": true
      },
      {
        "description": "fractional seconds are valid",
        "data": "id,x\n1,2024-01-15T09:45:30.125+02:00\n",
        "valid": true
      },
      {
        "description": "a date-time without an offset is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,2024-01-15T14:30:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30:00"
          }
        ]
      },
      {
        "description": "a bare date is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,2024-01-15\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "2024-01-15"
          }
        ]
      },
      {
        "description": "a word is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,yesterday\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "yesterday"
          }
        ]
      },
      {
        "description": "leading text is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,x2024-01-15T14:30:00Z\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "x2024-01-15T14:30:00Z"
          }
        ]
      },
      {
        "description": "trailing text is a cell/type error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,2024-01-15T14:30:00Zx\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30:00Zx"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable date-time column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#datetime"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,2024-01-15T14:30:00Z\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "date-time column with temporalFormat",
    "specification": [
      "https://fairspec.org/specs/table-schema/#datetime",
      "https://fairspec.org/specs/table-schema/#temporalformat"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "date-time",
          "temporalFormat": "%Y-%m-%d %H:%M:%S%z"
        }
      }
    },
    "tests": [
      {
        "description": "date-times in the format are valid",
        "data": "id,x\n1,2024-01-15 14:30:00+0200\n",
        "valid": true
      },
      {
        "description": "%z also reads an offset with a colon",
        "data": "id,x\n1,2024-01-15 14:30:00+02:00\n",
        "comment": "The spec's temporalFormat table: %z reading also accepts +HH:MM",
        "valid": true
      },
      {
        "description": "a date-time without an offset is a cell/type error",
        "data": "id,x\n1,2024-01-15 14:30:00+0200\n2,2024-01-15 14:30:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "2024-01-15 14:30:00"
          }
        ]
      }
    ]
  },
