[
  {
    "description": "date column",
    "specification": ["https://fairspec.org/specs/table-schema/#date"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "tests": [
      {
        "description": "ISO 8601 dates are valid",
        "data": "id,x\n1,2024-01-15\n2,1990-06-15\n",
        "valid": true
      },
      {
        "description": "month 13 is a cell/type error",
        "data": "id,x\n1,2024-01-15\n2,2024-13-01\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-13-01"
          }
        ]
      },
      {
        "description": "February 29 outside a leap year is a cell/type error",
        "data": "id,x\n1,2024-02-29\n2,2100-02-29\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2100-02-29"
          }
        ]
      },
      {
        "description": "a day-first date is a cell/type error",
        "data": "id,x\n1,2024-01-15\n2,15/01/2024\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "15/01/2024"
          }
        ]
      },
      {
        "description": "a date-time is a cell/type error",
        "data": "id,x\n1,2024-01-15\n2,2024-01-15T14:30:00\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-01-15T14:30:00"
          }
        ]
      },
      {
        "description": "an empty cell is a cell/missing error",
        "data": "id,x\n1,2024-01-15\n2,\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/missing",
            "columnName": "x",
            "rowNumber": 2,
            "cell": ""
          }
        ]
      }
    ]
  },
  {
    "description": "nullable date column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#type",
      "https://fairspec.org/specs/table-schema/#date"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "tests": [
      {
        "description": "an empty cell is valid",
        "data": "id,x\n1,2024-01-15\n2,\n",
        "valid": true
      }
    ]
  },
  {
    "description": "date column with temporalFormat",
    "specification": [
      "https://fairspec.org/specs/table-schema/#date",
      "https://fairspec.org/specs/table-schema/#temporalformat"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "date",
          "temporalFormat": "%m/%d/%Y"
        }
      }
    },
    "tests": [
      {
        "description": "dates in the format are valid",
        "data": "id,x\n1,01/15/2024\n2,12/31/2023\n",
        "valid": true
      },
      {
        "description": "an ISO date is a cell/type error",
        "data": "id,x\n1,01/15/2024\n2,2024-01-15\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "2024-01-15"
          }
        ]
      },
      {
        "description": "day 15 as month is a cell/type error",
        "data": "id,x\n1,01/15/2024\n2,15/01/2024\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date",
            "rowNumber": 2,
            "cell": "15/01/2024"
          }
        ]
      }
    ]
  },
  {
    "description": "time column",
    "specification": ["https://fairspec.org/specs/table-schema/#time"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "time"
        }
