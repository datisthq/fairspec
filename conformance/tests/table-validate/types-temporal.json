        "data": "id,x\n1,2024-01-15T12:00:00Z\n2,2024-1-15T12:00:00Z\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "date-time",
            "rowNumber": 2,
            "cell": "2024-1-15T12:00:00Z"
          }
        ]
      }
    ]
