[
  {
    "description": "enum on a duration column",
    "comment": "A row-parsed type checks its string constraints like every other column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#duration",
      "https://fairspec.org/specs/table-schema/#enum",
      "https://fairspec.org/specs/table-schema/#validation"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "duration",
          "enum": ["P1D", "PT2H"]
        }
      }
    },
    "tests": [
      {
        "description": "listed values are valid",
        "data": "id,x\n1,\"P1D\"\n2,\"PT2H\"\n",
        "valid": true
      },
      {
        "description": "an unlisted value is a cell/enum error",
        "data": "id,x\n1,\"P1D\"\n2,\"P22D\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/enum",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "P22D",
            "enum": ["P1D", "PT2H"]
          }
        ]
      },
      {
        "description": "an unreadable value is a cell/type error alone",
        "data": "id,x\n1,\"P1D\"\n2,\"1D\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "duration",
            "rowNumber": 2,
            "cell": "1D"
          }
        ]
      }
    ]
  },
  {
    "description": "const on a duration column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#duration",
      "https://fairspec.org/specs/table-schema/#const"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "duration",
          "const": "P1D"
        }
      }
    },
    "tests": [
      {
        "description": "the value is valid",
        "data": "id,x\n1,\"P1D\"\n2,\"P1D\"\n",
        "valid": true
      },
      {
        "description": "another value is a cell/const error",
        "data": "id,x\n1,\"P1D\"\n2,\"PT2H\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/const",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "PT2H",
            "const": "P1D"
          }
        ]
      }
    ]
  },
  {
    "description": "minLength and maxLength on a duration column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#duration",
      "https://fairspec.org/specs/table-schema/#minlength",
      "https://fairspec.org/specs/table-schema/#maxlength"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "duration",
          "minLength": 4,
          "maxLength": 4
        }
      }
    },
    "tests": [
      {
        "description": "a value of that length is valid",
        "data": "id,x\n1,\"PT2H\"\n",
        "valid": true
      },
      {
        "description": "a value of another length is a cell/minLength error",
        "data": "id,x\n1,\"PT2H\"\n2,\"P1D\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/minLength",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "P1D",
            "minLength": 4
          }
        ]
      }
    ]
  },
