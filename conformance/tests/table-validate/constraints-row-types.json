      {
        "description": "an unlisted value is a cell/enum error",
        "data": "id,x\n1,\"POINT (1 2)\"\n2,\"POINT (5 6)\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/enum",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "POINT (5 6)",
            "enum": ["POINT (1 2)", "POINT (3 4)"]
          }
        ]
      },
      {
        "description": "an unreadable value is a cell/type error alone",
        "data": "id,x\n1,\"POINT (1 2)\"\n2,\"NOPE (1 2)\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkt",
            "rowNumber": 2,
            "cell": "NOPE (1 2)"
          }
        ]
      }
    ]
  },
