  {
    "description": "enum on a wkb column",
    "comment": "A row-parsed type checks its string constraints like every other column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#wkb",
      "https://fairspec.org/specs/table-schema/#enum",
      "https://fairspec.org/specs/table-schema/#validation"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "string",
          "format": "wkb",
          "enum": [
            "0101000000000000000000F03F0000000000000040",
            "010100000000000000000008400000000000001040"
          ]
        }
      }
    },
    "tests": [
      {
        "description": "listed values are valid",
        "data": "id,x\n1,\"0101000000000000000000F03F0000000000000040\"\n2,\"010100000000000000000008400000000000001040\"\n",
        "valid": true
      },
      {
        "description": "an unlisted value is a cell/enum error",
        "data": "id,x\n1,\"0101000000000000000000F03F0000000000000040\"\n2,\"010100000000000000000014400000000000001840\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/enum",
            "columnName": "x",
            "rowNumber": 2,
            "cell": "010100000000000000000014400000000000001840",
            "enum": [
              "0101000000000000000000F03F0000000000000040",
              "010100000000000000000008400000000000001040"
            ]
          }
        ]
      },
      {
        "description": "an unreadable value is a cell/type error alone",
        "data": "id,x\n1,\"0101000000000000000000F03F0000000000000040\"\n2,\"ZZ\"\n",
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "columnName": "x",
            "columnType": "wkb",
            "rowNumber": 2,
            "cell": "ZZ"
          }
        ]
      }
    ]
  },
