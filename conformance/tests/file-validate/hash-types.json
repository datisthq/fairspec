    "integrity": { "type": "md5", "hash": "8b1a9953c4611296a827abf8c47804d7" },
    "tests": [
      { "description": "matching content is valid", "data": "Hello", "valid": true },
      {
        "description": "different content is a file/integrity error",
        "data": "Goodbye",
        "valid": false,
        "errors": [
          {
            "type": "file/integrity",
            "hashType": "md5",
            "expectedHash": "8b1a9953c4611296a827abf8c47804d7",
            "actualHash": "6fc422233a40a75a1f028e11c3cd1140"
          }
        ]
      },
      {
        "description": "an empty file is a file/integrity error",
        "data": "",
