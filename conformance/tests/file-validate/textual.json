[
  {
    "description": "textual true",
    "specification": ["https://fairspec.org/specs/dataset/#textual"],
    "textual": true,
    "tests": [
      { "description": "ascii is valid", "data": "id,name\n1,alice\n", "valid": true },
      {
        "description": "utf-8 with non-ascii characters is valid",
        "data": "id,name\n1,中文\n",
        "valid": true
      },
      { "description": "an empty file is valid", "data": "", "valid": true },
      {
        "description": "latin-1 bytes are a file/textual error",
        "data": { "base64": "Q2Fm6SBy6XN1bekgbmHvdmUg4CBQYXJpcy4=" },
        "valid": false,
        "errors": [{ "type": "file/textual" }]
      },
      {
        "description": "binary bytes are a file/textual error",
        "data": { "base64": "/9j/4AA=" },
        "valid": false,
        "errors": [{ "type": "file/textual" }]
      }
    ]
  },
  {
    "description": "textual false",
    "comment": "false makes no claim about the encoding, so nothing is checked",
    "specification": ["https://fairspec.org/specs/dataset/#textual"],
    "textual": false,
    "tests": [
      { "description": "utf-8 is valid", "data": "id,name\n1,alice\n", "valid": true },
      {
        "description": "latin-1 bytes are valid",
        "data": { "base64": "Q2Fm6SBy6XN1bekgbmHvdmUg4CBQYXJpcy4=" },
        "valid": true
      },
      {
        "description": "binary bytes are valid",
        "data": { "base64": "/9j/4AA=" },
        "valid": true
      }
    ]
  },
  {
    "description": "textual and integrity together",
    "comment": "both checks run; the spec does not order the errors, textual before integrity is the order both libraries share",
    "specification": [
      "https://fairspec.org/specs/dataset/#textual",
      "https://fairspec.org/specs/dataset/#integrity"
    ],
    "textual": true,
    "integrity": { "type": "md5", "hash": "8b1a9953c4611296a827abf8c47804d7" },
    "tests": [
      {
        "description": "utf-8 with a matching hash is valid",
        "data": "Hello",
        "valid": true
      },
      {
        "description": "binary bytes with a different hash are both errors",
        "data": { "base64": "/9j/4AA=" },
        "valid": false,
        "errors": [
          { "type": "file/textual" },
          {
            "type": "file/integrity",
            "hashType": "md5",
            "expectedHash": "8b1a9953c4611296a827abf8c47804d7",
            "actualHash": "214cba70917653c3950ee51aa05a4214"
          }
        ]
      }
    ]
  },
  {
    "description": "textual true with encodings other than utf-8",
    "comment": "Fixtures are raw bytes: utf-16le with a BOM ff fe then 'hi' (ff fe 68 00 69 00); abc then the first two bytes of 中 (e4 b8); a, a lone continuation byte (80), b",
    "specification": ["https://fairspec.org/specs/dataset/#textual"],
    "textual": true,
    "tests": [
      {
        "description": "utf-16 with a byte order mark is a file/textual error",
        "data": { "base64": "//5oAGkA" },
        "valid": false,
        "errors": [{ "type": "file/textual" }]
      },
      {
        "description": "a multi-byte character truncated at the end is a file/textual error",
        "data": { "base64": "YWJj5Lg=" },
        "valid": false,
        "errors": [{ "type": "file/textual" }]
      },
      {
        "description": "a stray continuation byte is a file/textual error",
        "data": { "base64": "YYBi" },
        "valid": false,
        "errors": [{ "type": "file/textual" }]
      }
    ]
  },
  {
    "description": "textual true with valid utf-8 edge cases",
    "comment": "Each is well-formed utf-8: a four-byte character, a lone carriage return, a single byte, U+10FFFF",
    "specification": ["https://fairspec.org/specs/dataset/#textual"],
    "textual": true,
    "tests": [
      {
        "description": "a four-byte character is valid",
        "data": "a😀b\n",
        "valid": true
      },
      {
        "description": "carriage returns only are valid",
        "data": "a\rb\r",
        "valid": true
      },
      { "description": "a single byte is valid", "data": "a", "valid": true },
      {
        "description": "the largest code point is valid",
        "data": "\udbff\udfff",
        "valid": true
      }
    ]
  }
]
