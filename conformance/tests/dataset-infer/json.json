[
  {
    "description": "json array of objects",
    "comment": "The data schema takes the TypeScript shape: no $schema and no required list",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#json",
      "https://fairspec.org/specs/file-dialect/#rowtype",
      "https://fairspec.org/specs/data-schema/#profile"
    ],
    "dataset": { "resources": [{ "data": "users.json" }] },
    "tests": [
      {
        "description": "gets a json dialect, a data schema and a table schema",
        "data": { "users.json": "[{\"id\": 1, \"name\": \"alice\"}]" },
        "expected": {
          "resources": [
            {
              "data": "users.json",
              "name": "users",
              "textual": true,
              "integrity": {
                "type": "sha256",
                "hash": "f8ee327133f543dcad698fe90e11665eae1dbeecea41cb3af54996657db49738"
              },
              "fileDialect": { "format": "json", "rowType": "object" },
              "dataSchema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" }
                  }
                }
              },
              "tableSchema": {
                "properties": {
                  "id": { "type": "integer" },
                  "name": { "type": "string" }
                }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "description": "json object",
    "comment": "The json format is for JSON array files, so a top-level object with no jsonPointer is not a table and gets no table schema",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#json",
      "https://fairspec.org/specs/dataset/#tableschema"
    ],
    "dataset": { "resources": [{ "data": "config.json" }] },
    "tests": [
      {
        "description": "gets a data schema and no table schema",
        "data": { "config.json": "{\"id\": 1}" },
        "expected": {
          "resources": [
            {
              "data": "config.json",
              "name": "config",
              "textual": true,
              "integrity": {
                "type": "sha256",
                "hash": "354aaef7a5f6ecbb2faee49fbe47a24e024cb62b3183b853a1ecc01e01920e49"
              },
              "fileDialect": { "format": "json" },
              "dataSchema": {
                "type": "object",
                "properties": { "id": { "type": "integer" } }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "description": "json object with a declared default dialect",
    "comment": "A declared json dialect does not make a top-level object a table",
    "specification": [
      "https://fairspec.org/specs/file-dialect/#json",
      "https://fairspec.org/specs/dataset/#tableschema"
    ],
    "dataset": {
      "resources": [{ "data": "config.json", "fileDialect": { "format": "json" } }]
    },
    "tests": [
      {
        "description": "gets a data schema and no table schema",
        "data": { "config.json": "{\"id\": 1}" },
        "expected": {
          "resources": [
            {
              "data": "config.json",
              "name": "config",
              "textual": true,
              "integrity": {
                "type": "sha256",
                "hash": "354aaef7a5f6ecbb2faee49fbe47a24e024cb62b3183b853a1ecc01e01920e49"
              },
              "fileDialect": { "format": "json" },
              "dataSchema": {
                "type": "object",
                "properties": { "id": { "type": "integer" } }
              }
            }
          ]
        }
      }
    ]
  },
  {
    "description": "inline data",
    "comment": "Inline data has no file, so it gets no dialect, textual flag or integrity. The spec does not say how an unnamed resource is named; the proposed answer is resource followed by its 1-based position, as dataset-list names it",
    "specification": [
      "https://fairspec.org/specs/dataset/#data",
      "https://fairspec.org/specs/dataset/#name"
    ],
    "dataset": { "resources": [{ "data": "users.csv" }, { "data": [{ "id": 1 }] }] },
    "tests": [
      {
        "description": "gets a positional name, a data schema and a table schema",
        "data": { "users.csv": "id\n1\n" },
        "expected": {
          "resources": [
            {
              "data": "users.csv",
              "name": "users",
              "textual": true,
              "integrity": {
                "type": "sha256",
                "hash": "7cde7fb64fd82bd152710cf238e017b9ab46c0592483edc067ba4f6c75fac108"
              },
              "fileDialect": {
                "format": "csv",
                "delimiter": ",",
                "headerRows": [1],
                "lineTerminator": "\n"
              },
              "tableSchema": { "properties": { "id": { "type": "integer" } } }
            },
            {
              "data": [{ "id": 1 }],
              "name": "resource2",
              "dataSchema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "id": { "type": "integer" } }
                }
              },
              "tableSchema": { "properties": { "id": { "type": "integer" } } }
            }
          ]
        }
      }
    ]
  }
]
