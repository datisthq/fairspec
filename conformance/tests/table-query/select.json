[
  {
    "description": "filter and project",
    "comment": "Querying is a library feature the spec does not define; the query runs against the table typed by its table schema",
    "specification": [
      "https://fairspec.org/specs/table-schema/#integer",
      "https://fairspec.org/specs/table-schema/#string"
    ],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT name FROM self WHERE id > 1",
    "tests": [
      {
        "description": "keeps matching rows and the selected column",
        "data": "id,name\n1,alice\n2,bob\n3,carol\n",
        "expected": { "columns": ["name"], "rows": [["bob"], ["carol"]] }
      },
      {
        "description": "no matching row keeps the columns",
        "data": "id,name\n1,alice\n",
        "expected": { "columns": ["name"], "rows": [] }
      }
    ]
  },
  {
    "description": "select all",
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT * FROM self",
    "tests": [
      {
        "description": "returns every column in table order",
        "data": "id,name\n1,alice\n2,bob\n",
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, "bob"]
          ]
        }
      }
    ]
  },
  {
    "description": "columns renamed and reordered",
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT name AS label, id FROM self",
    "tests": [
      {
        "description": "follows the select list",
        "data": "id,name\n1,alice\n",
        "expected": { "columns": ["label", "id"], "rows": [["alice", 1]] }
      }
    ]
  },
  {
    "description": "filter on a boolean column",
    "specification": ["https://fairspec.org/specs/table-schema/#boolean"],
    "tableSchema": {
      "properties": { "name": { "type": "string" }, "active": { "type": "boolean" } }
    },
    "query": "SELECT name, active FROM self WHERE active",
    "tests": [
      {
        "description": "true and false are parsed before the filter",
        "data": "name,active\nalice,true\nbob,false\n",
        "expected": { "columns": ["name", "active"], "rows": [["alice", true]] }
      }
    ]
  },
  {
    "description": "filter on a number column",
    "specification": ["https://fairspec.org/specs/table-schema/#number"],
    "tableSchema": {
      "properties": { "name": { "type": "string" }, "score": { "type": "number" } }
    },
    "query": "SELECT name, score FROM self WHERE score > 2",
    "tests": [
      {
        "description": "compares numerically",
        "data": "name,score\nalice,1.5\nbob,2.5\ncarol,10.5\n",
        "expected": {
          "columns": ["name", "score"],
          "rows": [
            ["bob", 2.5],
            ["carol", 10.5]
          ]
        }
      }
    ]
  },
  {
    "description": "filter on missing values",
    "comment": "An empty cell is a missing value by default, so it is null in the query",
    "specification": ["https://fairspec.org/specs/table-schema/#missingvalues"],
    "tableSchema": {
      "properties": { "name": { "type": "string" }, "score": { "type": "number" } }
    },
    "query": "SELECT name FROM self WHERE score IS NULL",
    "tests": [
      {
        "description": "an empty cell is null",
        "data": "name,score\nalice,1.5\nbob,\n",
        "expected": { "columns": ["name"], "rows": [["bob"]] }
      }
    ]
  },
  {
    "description": "distinct",
    "comment": "SQL leaves the default position of nulls to the engine, so the queries name it with NULLS FIRST or NULLS LAST",
    "tableSchema": {
      "properties": {
        "city": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT DISTINCT city FROM self ORDER BY city NULLS LAST",
    "tests": [
      {
        "description": "keeps one row per value",
        "data": "city,id\nrome,1\nparis,2\nrome,3\n",
        "expected": {
          "columns": ["city"],
          "rows": [["paris"], ["rome"]]
        }
      },
      {
        "description": "keeps one null",
        "data": "city,id\nrome,1\n,2\n,3\n",
        "expected": {
          "columns": ["city"],
          "rows": [["rome"], [null]]
        }
      }
    ]
  },
  {
    "description": "distinct rows",
    "tableSchema": {
      "properties": {
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "string"
        }
      }
    },
    "query": "SELECT DISTINCT a, b FROM self ORDER BY a, b",
    "tests": [
      {
        "description": "compares whole rows",
        "data": "a,b\n1,x\n1,y\n1,x\n2,x\n",
        "expected": {
          "columns": ["a", "b"],
          "rows": [
            [1, "x"],
            [1, "y"],
            [2, "x"]
          ]
        }
      }
    ]
  },
  {
    "description": "comparison with null",
    "comment": "SQL compares a null to nothing: the comparison is unknown and the row is dropped",
    "specification": ["https://fairspec.org/specs/table-schema/#missingvalues"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT id FROM self WHERE score <> 5 ORDER BY id",
    "tests": [
      {
        "description": "a missing value matches no comparison",
        "data": "id,score\n1,5\n2,\n3,7\n",
        "expected": {
          "columns": ["id"],
          "rows": [[3]]
        }
      }
    ]
  },
  {
    "description": "negated boolean filter",
    "specification": [
      "https://fairspec.org/specs/table-schema/#boolean",
      "https://fairspec.org/specs/table-schema/#missingvalues"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "query": "SELECT id FROM self WHERE NOT active ORDER BY id",
    "tests": [
      {
        "description": "a missing value is neither true nor false",
        "data": "id,active\n1,true\n2,false\n3,\n",
        "expected": {
          "columns": ["id"],
          "rows": [[2]]
        }
      }
    ]
  },
  {
    "description": "filter with a list of values",
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "query": "SELECT id FROM self WHERE name IN ('alice', 'carol') ORDER BY id",
    "tests": [
      {
        "description": "keeps rows whose value is listed",
        "data": "id,name\n1,alice\n2,bob\n3,carol\n4,Alice\n",
        "expected": {
          "columns": ["id"],
          "rows": [[1], [3]]
        }
      }
    ]
  },
  {
    "description": "filter on a range",
    "specification": ["https://fairspec.org/specs/table-schema/#number"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "number"
        }
      }
    },
    "query": "SELECT id FROM self WHERE x BETWEEN 1 AND 2 ORDER BY id",
    "tests": [
      {
        "description": "includes both bounds",
        "data": "id,x\n1,0.5\n2,1\n3,1.5\n4,2\n5,2.5\n",
        "expected": {
          "columns": ["id"],
          "rows": [[2], [3], [4]]
        }
      }
    ]
  },
  {
    "description": "filter with a pattern",
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "query": "SELECT id FROM self WHERE name LIKE 'a%' ORDER BY id",
    "tests": [
      {
        "description": "is case-sensitive",
        "data": "id,name\n1,alice\n2,Anna\n3,bob\n4,amy\n",
        "expected": {
          "columns": ["id"],
          "rows": [[1], [4]]
        }
      }
    ]
  },
  {
    "description": "filter on schema missing values",
    "specification": ["https://fairspec.org/specs/table-schema/#missingvalues"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        }
      },
      "missingValues": ["NA", "-999"]
    },
    "query": "SELECT id FROM self WHERE score IS NULL ORDER BY id",
    "tests": [
      {
        "description": "a listed token is null",
        "data": "id,score\n1,5\n2,NA\n3,-999\n",
        "expected": {
          "columns": ["id"],
          "rows": [[2], [3]]
        }
      }
    ]
  },
  {
    "description": "filter on custom boolean values",
    "specification": [
      "https://fairspec.org/specs/table-schema/#truevalues",
      "https://fairspec.org/specs/table-schema/#falsevalues"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "ok": {
          "type": "boolean",
          "trueValues": ["yes"],
          "falseValues": ["no"]
        }
      }
    },
    "query": "SELECT id, ok FROM self WHERE ok",
    "tests": [
      {
        "description": "parses the declared words",
        "data": "id,ok\n1,yes\n2,no\n3,yes\n",
        "expected": {
          "columns": ["id", "ok"],
          "rows": [
            [1, true],
            [3, true]
          ]
        }
      }
    ]
  },
  {
    "description": "filter on a number with a decimal comma",
    "specification": ["https://fairspec.org/specs/table-schema/#decimalchar"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "x": {
          "type": "number",
          "decimalChar": ","
        }
      }
    },
    "query": "SELECT id, x FROM self WHERE x > 1",
    "tests": [
      {
        "description": "compares the parsed value",
        "data": "id,x\n1,\"0,5\"\n2,\"1,5\"\n",
        "expected": {
          "columns": ["id", "x"],
          "rows": [[2, 1.5]]
        }
      }
    ]
  },
  {
    "description": "filter on a number with text",
    "specification": ["https://fairspec.org/specs/table-schema/#withtext"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "price": {
          "type": "number",
          "withText": true
        }
      }
    },
    "query": "SELECT id, price FROM self WHERE price < 0",
    "tests": [
      {
        "description": "a minus in the stripped prefix makes it negative",
        "data": "id,price\n1,$5.00\n2,-$2.50\n",
        "expected": {
          "columns": ["id", "price"],
          "rows": [[2, -2.5]]
        }
      }
    ]
  },
  {
    "description": "select a list column",
    "comment": "A list cell is split on its delimiter, so the query sees its items. The spec gives the delimiter no default, so it is declared",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#delimiter"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "tags": {
          "type": "string",
          "format": "list",
          "delimiter": ","
        }
      }
    },
    "query": "SELECT id, tags FROM self WHERE id > 1",
    "tests": [
      {
        "description": "the items come back as an array",
        "data": "id,tags\n1,\"a,b\"\n2,\"c,d\"\n3,e\n",
        "expected": {
          "columns": ["id", "tags"],
          "rows": [
            [2, ["c", "d"]],
            [3, ["e"]]
          ]
        }
      }
    ]
  },
  {
    "description": "select a typed list column",
    "specification": [
      "https://fairspec.org/specs/table-schema/#list",
      "https://fairspec.org/specs/table-schema/#delimiter",
      "https://fairspec.org/specs/table-schema/#itemtype"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "ns": {
          "type": "string",
          "format": "list",
          "delimiter": ",",
          "itemType": "integer"
        }
      }
    },
    "query": "SELECT ns FROM self ORDER BY id",
    "tests": [
      {
        "description": "the items take the item type",
        "data": "id,ns\n1,\"1,2\"\n2,3\n",
        "expected": {
          "columns": ["ns"],
          "rows": [[[1, 2]], [[3]]]
        }
      }
    ]
  }
]
