          "type": "integer"
        },
        "score": {
          "type": ["integer", "null"]
        }
      }
    },
    "query": "SELECT id FROM self ORDER BY score DESC, id",
    "tests": [
      {
        "description": "matches the sorting rules",
        "data": "id,score\n1,20\n2,\n3,10\n4,\n",
        "expected": {
          "columns": ["id"],
          "rows": [[1], [3], [2], [4]]
        }
      }
    ]
  },
