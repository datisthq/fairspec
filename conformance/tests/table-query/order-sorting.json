[
  {
    "description": "ascending order without a nulls clause",
    "specification": ["https://fairspec.org/specs/table-schema/#sorting"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "score": {
          "type": ["integer", "null"]
        }
      }
    },
    "query": "SELECT id FROM self ORDER BY score, id",
    "tests": [
      {
        "description": "matches the sorting rules",
        "data": "id,score\n1,20\n2,\n3,10\n4,\n",
        "expected": {
          "columns": ["id"],
          "rows": [[3], [1], [2], [4]]
        }
      }
    ]
  },
  {
    "description": "descending order without a nulls clause",
    "specification": ["https://fairspec.org/specs/table-schema/#sorting"],
    "tableSchema": {
      "properties": {
