[
  {
    "description": "count",
    "comment": "Querying is a library feature the spec does not define. Aggregates are aliased, since an unaliased aggregate's column name is engine-specific",
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT COUNT(*) AS n FROM self",
    "tests": [
      {
        "description": "counts the rows as an integer",
        "data": "id,name\n1,alice\n2,bob\n3,carol\n",
        "expected": { "columns": ["n"], "rows": [[3]] }
      }
    ]
  },
  {
    "description": "count of a column skips nulls",
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT COUNT(name) AS n FROM self",
    "tests": [
      {
        "description": "a missing value is not counted",
        "data": "id,name\n1,alice\n2,\n3,carol\n",
        "expected": { "columns": ["n"], "rows": [[2]] }
      }
    ]
  },
  {
    "description": "sum",
    "specification": [
      "https://fairspec.org/specs/table-schema/#integer",
      "https://fairspec.org/specs/table-schema/#number"
    ],
    "tableSchema": {
      "properties": { "count": { "type": "integer" }, "price": { "type": "number" } }
    },
    "query": "SELECT SUM(count) AS total, SUM(price) AS amount FROM self",
    "tests": [
      {
        "description": "an integer sum stays an integer and a number sum a number",
        "data": "count,price\n1,0.25\n2,1.25\n",
        "expected": { "columns": ["total", "amount"], "rows": [[3, 1.5]] }
      }
    ]
  },
  {
    "description": "group by",
    "tableSchema": {
      "properties": { "city": { "type": "string" }, "count": { "type": "integer" } }
    },
    "query": "SELECT city, COUNT(*) AS n, SUM(count) AS total FROM self GROUP BY city ORDER BY city",
    "tests": [
      {
        "description": "one row per group",
        "data": "city,count\nparis,1\nrome,2\nparis,3\n",
        "expected": {
          "columns": ["city", "n", "total"],
          "rows": [
            ["paris", 2, 4],
            ["rome", 1, 2]
          ]
        }
      }
    ]
  },
  {
    "description": "group by a key with nulls",
    "comment": "SQL leaves the default position of nulls to the engine, so the queries name it with NULLS FIRST or NULLS LAST",
    "specification": ["https://fairspec.org/specs/table-schema/#missingvalues"],
    "tableSchema": {
      "properties": {
        "city": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT city, COUNT(*) AS n FROM self GROUP BY city ORDER BY city NULLS LAST",
    "tests": [
      {
        "description": "missing keys form one group",
        "data": "city,id\nparis,1\n,2\nrome,3\nparis,4\n,5\n",
        "expected": {
          "columns": ["city", "n"],
          "rows": [
            ["paris", 2],
            ["rome", 1],
            [null, 2]
          ]
        }
      }
    ]
  },
  {
    "description": "group by a boolean column",
    "specification": ["https://fairspec.org/specs/table-schema/#boolean"],
    "tableSchema": {
      "properties": {
        "flag": {
          "type": "boolean"
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT flag, SUM(count) AS total FROM self GROUP BY flag ORDER BY flag",
    "tests": [
      {
        "description": "one row per value",
        "data": "flag,count\ntrue,1\nfalse,2\ntrue,3\n",
        "expected": {
          "columns": ["flag", "total"],
          "rows": [
            [false, 2],
            [true, 4]
          ]
        }
      }
    ]
  },
  {
    "description": "having",
    "tableSchema": {
      "properties": {
        "city": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT city, SUM(count) AS total FROM self GROUP BY city HAVING SUM(count) > 2 ORDER BY city",
    "tests": [
      {
        "description": "filters the groups",
        "data": "city,count\nparis,1\nrome,2\nparis,3\nberlin,5\n",
        "expected": {
          "columns": ["city", "total"],
          "rows": [
            ["berlin", 5],
            ["paris", 4]
          ]
        }
      }
    ]
  },
  {
    "description": "average",
    "comment": "AVG skips nulls in SQL. Over an integer column its result type is implementation-defined, so only a number column is averaged",
    "specification": ["https://fairspec.org/specs/table-schema/#number"],
    "tableSchema": {
      "properties": {
        "price": {
          "type": "number"
        }
      }
    },
    "query": "SELECT AVG(price) AS a FROM self",
    "tests": [
      {
        "description": "averages the values",
        "data": "price\n0.5\n1.0\n",
        "expected": {
          "columns": ["a"],
          "rows": [[0.75]]
        }
      },
      {
        "description": "skips missing values",
        "data": "price,note\n0.5,a\n,b\n2.0,c\n",
        "expected": {
          "columns": ["a"],
          "rows": [[1.25]]
        }
      }
    ]
  },
  {
    "description": "min and max",
    "specification": [
      "https://fairspec.org/specs/table-schema/#integer",
      "https://fairspec.org/specs/table-schema/#string"
    ],
    "tableSchema": {
      "properties": {
        "count": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "query": "SELECT MIN(count) AS lo, MAX(count) AS hi, MIN(name) AS first, MAX(name) AS last FROM self",
    "tests": [
      {
        "description": "keep the column type",
        "data": "count,name\n10,bob\n-3,alice\n7,carol\n",
        "expected": {
          "columns": ["lo", "hi", "first", "last"],
          "rows": [[-3, 10, "alice", "carol"]]
        }
      },
      {
        "description": "skip missing values",
        "data": "count,name\n10,\n,alice\n7,carol\n",
        "expected": {
          "columns": ["lo", "hi", "first", "last"],
          "rows": [[7, 10, "alice", "carol"]]
        }
      }
    ]
  },
  {
    "description": "min and max of a number column",
    "specification": ["https://fairspec.org/specs/table-schema/#number"],
    "tableSchema": {
      "properties": {
        "x": {
          "type": "number"
        }
      }
    },
    "query": "SELECT MIN(x) AS lo, MAX(x) AS hi FROM self",
    "tests": [
      {
        "description": "compare numerically",
        "data": "x\n10.5\n9.25\n-1.5\n",
        "expected": {
          "columns": ["lo", "hi"],
          "rows": [[-1.5, 10.5]]
        }
      }
    ]
  },
  {
    "description": "count distinct",
    "tableSchema": {
      "properties": {
        "city": {
          "type": "string"
        }
      }
    },
    "query": "SELECT COUNT(DISTINCT city) AS n FROM self",
    "tests": [
      {
        "description": "counts each value once and skips nulls",
        "data": "city,note\nparis,a\nrome,b\nparis,c\n,d\n",
        "expected": {
          "columns": ["n"],
          "rows": [[2]]
        }
      }
    ]
  },
  {
    "description": "sum of a column with missing values",
    "specification": ["https://fairspec.org/specs/table-schema/#missingvalues"],
    "tableSchema": {
      "properties": {
        "count": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT SUM(count) AS total FROM self",
    "tests": [
      {
        "description": "skips missing values",
        "data": "count,note\n1,a\n,b\n3,c\n",
        "expected": {
          "columns": ["total"],
          "rows": [[4]]
        }
      }
    ]
  }
]
