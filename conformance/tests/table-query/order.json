[
  {
    "description": "order by an integer column",
    "comment": "Ordering compares typed values, so 10 sorts after 9",
    "specification": ["https://fairspec.org/specs/table-schema/#integer"],
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT id FROM self ORDER BY id",
    "tests": [
      {
        "description": "sorts numerically",
        "data": "id,name\n10,a\n9,b\n100,c\n",
        "expected": { "columns": ["id"], "rows": [[9], [10], [100]] }
      }
    ]
  },
  {
    "description": "order by descending with a limit",
    "tableSchema": {
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    },
    "query": "SELECT name FROM self ORDER BY id DESC LIMIT 2",
    "tests": [
      {
        "description": "takes the highest rows first",
        "data": "id,name\n1,alice\n3,carol\n2,bob\n",
        "expected": { "columns": ["name"], "rows": [["carol"], ["bob"]] }
      }
    ]
  },
  {
    "description": "order by a string column",
    "tableSchema": {
      "properties": { "name": { "type": "string" } }
    },
    "query": "SELECT name FROM self ORDER BY name",
    "tests": [
      {
        "description": "sorts by code point",
        "data": "name\nbob\nAlice\nalice\n",
        "expected": { "columns": ["name"], "rows": [["Alice"], ["alice"], ["bob"]] }
      }
    ]
  },
  {
    "description": "order by with nulls first",
    "comment": "An explicit NULLS FIRST or NULLS LAST overrides the default of nulls last",
    "specification": [
      "https://fairspec.org/specs/table-schema/#missingvalues",
      "https://fairspec.org/specs/table-schema/#sorting"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT id FROM self ORDER BY score NULLS FIRST, id",
    "tests": [
      {
        "description": "missing values sort before every value",
        "data": "id,score\n1,20\n2,\n3,10\n4,\n",
        "expected": {
          "columns": ["id"],
          "rows": [[2], [4], [3], [1]]
        }
      }
    ]
  },
  {
    "description": "order by with nulls last",
    "comment": "An explicit NULLS FIRST or NULLS LAST overrides the default of nulls last",
    "specification": [
      "https://fairspec.org/specs/table-schema/#missingvalues",
      "https://fairspec.org/specs/table-schema/#sorting"
    ],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT id FROM self ORDER BY score DESC NULLS LAST, id",
    "tests": [
      {
        "description": "missing values sort after every value",
        "data": "id,score\n1,20\n2,\n3,10\n4,30\n",
        "expected": {
          "columns": ["id"],
          "rows": [[4], [1], [3], [2]]
        }
      }
    ]
  },
  {
    "description": "order by two keys",
    "tableSchema": {
      "properties": {
        "city": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT city, id FROM self ORDER BY city, id DESC",
    "tests": [
      {
        "description": "the second key breaks ties",
        "data": "city,id\nrome,1\nparis,2\nrome,3\nparis,4\n",
        "expected": {
          "columns": ["city", "id"],
          "rows": [
            ["paris", 4],
            ["paris", 2],
            ["rome", 3],
            ["rome", 1]
          ]
        }
      }
    ]
  },
  {
    "description": "order by a number column",
    "specification": ["https://fairspec.org/specs/table-schema/#number"],
    "tableSchema": {
      "properties": {
        "x": {
          "type": "number"
        }
      }
    },
    "query": "SELECT x FROM self ORDER BY x",
    "tests": [
      {
        "description": "negatives sort before positives",
        "data": "x\n1.5\n-2.25\n0.5\n-10\n",
        "expected": {
          "columns": ["x"],
          "rows": [[-10.0], [-2.25], [0.5], [1.5]]
        }
      }
    ]
  },
  {
    "description": "order by a boolean column",
    "specification": ["https://fairspec.org/specs/table-schema/#boolean"],
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        },
        "flag": {
          "type": "boolean"
        }
      }
    },
    "query": "SELECT id FROM self ORDER BY flag, id",
    "tests": [
      {
        "description": "false sorts before true",
        "data": "id,flag\n1,true\n2,false\n3,true\n4,false\n",
        "expected": {
          "columns": ["id"],
          "rows": [[2], [4], [1], [3]]
        }
      }
    ]
  },
  {
    "description": "order by a grouped integer column",
    "specification": ["https://fairspec.org/specs/table-schema/#groupchar"],
    "tableSchema": {
      "properties": {
        "n": {
          "type": "integer",
          "groupChar": ","
        }
      }
    },
    "query": "SELECT n FROM self ORDER BY n",
    "tests": [
      {
        "description": "sorts the parsed values",
        "data": "n\n\"1,000\"\n999\n\"10,000\"\n",
        "expected": {
          "columns": ["n"],
          "rows": [[999], [1000], [10000]]
        }
      }
    ]
  },
  {
    "description": "order by with an offset",
    "tableSchema": {
      "properties": {
        "id": {
          "type": "integer"
        }
      }
    },
    "query": "SELECT id FROM self ORDER BY id LIMIT 2 OFFSET 1",
    "tests": [
      {
        "description": "skips the first row",
        "data": "id\n3\n1\n4\n2\n",
        "expected": {
          "columns": ["id"],
          "rows": [[2], [3]]
        }
      },
      {
        "description": "an offset past the end keeps the columns",
        "data": "id\n1\n",
        "expected": {
          "columns": ["id"],
          "rows": []
        }
      }
    ]
  }
]
