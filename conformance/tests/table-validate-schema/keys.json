[
  {
    "description": "key columns and foreign key lengths",
    "specification": [
      "https://fairspec.org/specs/table-schema/#primarykey",
      "https://fairspec.org/specs/table-schema/#uniquekeys",
      "https://fairspec.org/specs/table-schema/#foreignkeys"
    ],
    "tests": [
      {
        "description": "primaryKey names a column not in properties",
        "data": {
          "primaryKey": ["nope"],
          "properties": {
            "id": {
              "type": "integer"
            }
          }
        },
        "valid": false,
        "errors": [
          {
            "type": "metadata",
            "jsonPointer": "/primaryKey/0"
          }
        ]
      },
      {
        "description": "uniqueKeys names a column not in properties",
        "data": {
          "uniqueKeys": [["id", "nope"]],
          "properties": {
            "id": {
              "type": "integer"
            }
          }
        },
        "valid": false,
        "errors": [
          {
            "type": "metadata",
            "jsonPointer": "/uniqueKeys/0/1"
          }
        ]
      },
      {
        "description": "foreign key columns name a column not in properties",
        "data": {
          "foreignKeys": [
            {
              "columns": ["nope"],
              "reference": {
                "resource": "r",
                "columns": ["x"]
              }
            }
          ],
          "properties": {
            "id": {
              "type": "integer"
            }
          }
        },
        "valid": false,
        "errors": [
          {
            "type": "metadata",
            "jsonPointer": "/foreignKeys/0/columns/0"
          }
        ]
      },
      {
        "description": "foreign key columns of different lengths",
        "data": {
          "foreignKeys": [
            {
              "columns": ["a", "b"],
              "reference": {
                "resource": "r",
                "columns": ["x"]
              }
            }
          ],
          "properties": {
            "a": {
              "type": "integer"
            },
            "b": {
              "type": "integer"
            }
          }
        },
        "valid": false,
        "errors": [
          {
            "type": "metadata",
            "jsonPointer": "/foreignKeys/0/reference/columns"
          }
        ]
      },
      {
        "description": "keys naming existing columns are valid",
        "data": {
          "primaryKey": ["a"],
          "uniqueKeys": [["a", "b"]],
          "foreignKeys": [
            {
              "columns": ["b"],
              "reference": {
                "resource": "r",
                "columns": ["x"]
              }
            }
          ],
          "properties": {
            "a": {
              "type": "integer"
            },
            "b": {
              "type": "integer"
            }
          }
        },
        "valid": true
      }
    ]
  },
  {
    "description": "empty keys",
    "specification": [
      "https://fairspec.org/specs/table-schema/#primarykey",
      "https://fairspec.org/specs/table-schema/#uniquekeys",
      "https://fairspec.org/specs/table-schema/#foreignkeys"
    ],
    "tests": [
      {
        "description": "an empty primaryKey is invalid",
        "data": {
          "primaryKey": [],
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "valid": false
      },
      {
        "description": "an empty unique key is invalid",
        "data": {
          "uniqueKeys": [[]],
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "valid": false
      },
      {
        "description": "an empty unique key after a valid one is invalid",
        "data": {
          "uniqueKeys": [["email"], []],
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "valid": false
      },
      {
        "description": "an empty uniqueKeys list is invalid",
        "data": {
          "uniqueKeys": [],
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "valid": false
      },
      {
        "description": "a foreign key with empty reference columns is invalid",
        "data": {
          "foreignKeys": [
            {
              "columns": ["id"],
              "reference": {
                "resource": "r",
                "columns": []
              }
            }
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string"
            }
          }
        },
        "valid": false
      }
    ]
  },
  {
    "description": "a self-referencing foreign key with differing column types",
    "specification": ["https://fairspec.org/specs/table-schema/#foreignkeys"],
    "tests": [
      {
        "description": "an integer column referencing a string column is a metadata error",
        "data": {
          "properties": {
            "id": {
              "type": "string"
            },
            "parent_id": {
              "type": "integer"
            }
          },
          "foreignKeys": [
            {
              "columns": ["parent_id"],
              "reference": {
                "columns": ["id"]
              }
            }
          ]
        },
        "valid": false,
        "errors": [
          {
            "type": "metadata",
            "jsonPointer": "/foreignKeys/0"
          }
        ]
      },
      {
        "description": "an integer column referencing a number column is valid",
        "data": {
          "properties": {
            "id": {
              "type": "number"
            },
            "parent_id": {
              "type": ["integer", "null"]
            }
          },
          "foreignKeys": [
            {
              "columns": ["parent_id"],
              "reference": {
                "columns": ["id"]
              }
            }
          ]
        },
        "valid": true
      },
      {
        "description": "a reference to another resource is not checked here",
        "data": {
          "properties": {
            "parent_id": {
              "type": "integer"
            }
          },
          "foreignKeys": [
            {
              "columns": ["parent_id"],
              "reference": {
                "resource": "other",
                "columns": ["id"]
              }
            }
          ]
        },
        "valid": true
      }
    ]
  }
]
