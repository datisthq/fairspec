[
  {
    "description": "an inline resource",
    "comment": "Querying is a library feature the spec does not define; the relation holds the inline rows in order",
    "specification": ["https://fairspec.org/specs/dataset/#data"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": [
            { "id": 1, "name": "alice" },
            { "id": 2, "name": "bob" }
          ],
          "tableSchema": {
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
          }
        }
      ]
    },
    "query": "SELECT name FROM people WHERE id = 2",
    "tests": [
      {
        "description": "is queried under its name",
        "data": {},
        "expected": { "columns": ["name"], "rows": [["bob"]] }
      }
    ]
  },
  {
    "description": "a multipart resource",
    "comment": "Querying is a library feature the spec does not define. The records of a multipart resource are the records of each part, so the parts form one relation and each part's header row is not a record",
    "specification": ["https://fairspec.org/specs/dataset/#data"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.csv", "part2.csv"],
          "fileDialect": { "format": "csv" },
          "tableSchema": {
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
          }
        }
      ]
    },
    "query": "SELECT id, name FROM people ORDER BY id",
    "tests": [
      {
        "description": "is one relation of every part's records",
        "data": {
          "part1.csv": "id,name\n1,alice\n2,bob\n",
          "part2.csv": "id,name\n3,carol\n"
        },
        "expected": {
          "columns": ["id", "name"],
          "rows": [
            [1, "alice"],
            [2, "bob"],
            [3, "carol"]
          ]
        }
      },
      {
        "description": "a part with only its header row adds no records",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\n" },
        "expected": { "columns": ["id", "name"], "rows": [[1, "alice"]] }
      }
    ]
  },
  {
    "description": "a multipart resource joined with another",
    "comment": "Querying is a library feature the spec does not define",
    "specification": ["https://fairspec.org/specs/dataset/#data"],
    "dataset": {
      "resources": [
        {
          "name": "users",
          "data": "users.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": {
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
          }
        },
        {
          "name": "posts",
          "data": ["posts1.csv", "posts2.csv"],
          "fileDialect": { "format": "csv" },
          "tableSchema": { "properties": { "user_id": { "type": "integer" } } }
        }
      ]
    },
    "query": "SELECT users.name, COUNT(*) AS n FROM posts JOIN users ON posts.user_id = users.id GROUP BY users.name ORDER BY users.name",
    "tests": [
      {
        "description": "counts rows from both parts",
        "data": {
          "users.csv": "id,name\n1,alice\n2,bob\n",
          "posts1.csv": "user_id\n1\n2\n",
          "posts2.csv": "user_id\n2\n"
        },
        "expected": {
          "columns": ["name", "n"],
          "rows": [
            ["alice", 1],
            ["bob", 2]
          ]
        }
      }
    ]
  }
]
