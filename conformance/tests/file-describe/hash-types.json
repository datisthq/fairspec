          "textual": true,
          "integrity": {
            "type": "sha1",
            "hash": "f7ff9e8b7bb2e09b70935a5d785e0cc5d9d0abf0"
          }
        }
      },
      {
        "description": "an empty file",
        "data": "",
        "expected": {
          "bytes": 0,
          "textual": true,
          "integrity": {
            "type": "sha1",
            "hash": "da39a3ee5e6b4b0d3255bfef95601890afd80709"
          }
        }
      },
      {
        "description": "latin-1 bytes",
        "data": { "base64": "Q2Fm6SBy6XN1bekgbmHvdmUg4CBQYXJpcy4=" },
        "expected": {
          "bytes": 26,
          "textual": false,
          "integrity": {
            "type": "sha1",
            "hash": "fc482fbf255bfe42f2ae15d38c2ba690ddfa68af"
          }
        }
      }
    ]
  },
