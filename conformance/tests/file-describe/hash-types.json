[
  {
    "description": "md5 integrity",
    "specification": ["https://fairspec.org/specs/dataset/#integrity"],
    "options": { "hashType": "md5" },
    "tests": [
      {
        "description": "Hello",
        "data": "Hello",
        "expected": {
          "bytes": 5,
          "textual": true,
          "integrity": { "type": "md5", "hash": "8b1a9953c4611296a827abf8c47804d7" }
        }
      },
      {
        "description": "an empty file",
        "data": "",
        "expected": {
          "bytes": 0,
          "textual": true,
          "integrity": { "type": "md5", "hash": "d41d8cd98f00b204e9800998ecf8427e" }
        }
      },
      {
        "description": "binary bytes",
        "data": { "base64": "/9j/4AA=" },
        "expected": {
          "bytes": 5,
          "textual": false,
          "integrity": { "type": "md5", "hash": "214cba70917653c3950ee51aa05a4214" }
        }
      }
    ]
  },
  {
    "description": "sha1 integrity",
