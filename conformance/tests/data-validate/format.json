[
  {
    "description": "data that is not json",
    "comment": "A data schema requires the data to be a JSON document. The spec names no error type; resource/type with expectedResourceType data is the shape the TypeScript library reports",
    "specification": ["https://fairspec.org/specs/dataset/#dataschema"],
    "dataSchema": { "type": "object" },
    "tests": [
      {
        "description": "a csv file is a resource/type error",
        "data": "id,name\n1,alice\n",
        "valid": false,
        "errors": [{ "type": "resource/type", "expectedResourceType": "data" }]
      }
    ]
  },
  {
    "description": "no data schema",
    "specification": ["https://fairspec.org/specs/dataset/#dataschema"],
    "format": "json",
    "tests": [
      {
        "description": "any json document is valid",
        "data": "{\"name\": 1}",
        "valid": true
      }
    ]
  }
]
