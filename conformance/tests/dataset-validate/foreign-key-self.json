[
  {
    "description": "self-referencing foreign key",
    "comment": "A reference without resource points to the table itself",
    "specification": ["https://fairspec.org/specs/table-schema/#foreignkeys"],
    "dataset": {
      "resources": [
        {
          "name": "tree",
          "data": "tree.csv",
          "tableSchema": {
            "properties": {
              "id": { "type": "integer" },
              "parent_id": { "type": ["integer", "null"] }
            },
            "foreignKeys": [
              { "columns": ["parent_id"], "reference": { "columns": ["id"] } }
            ]
          }
        }
      ]
    },
    "tests": [
      {
        "description": "references to rows of the same table are valid",
        "data": { "tree.csv": "id,parent_id\n1,1\n2,1\n3,2\n" },
        "valid": true
      },
      {
        "description": "a reference to an absent row is a foreignKey error",
        "data": { "tree.csv": "id,parent_id\n1,1\n2,9\n" },
        "valid": false,
        "errors": [
          {
            "type": "foreignKey",
            "resourceName": "tree",
            "foreignKey": {
              "columns": ["parent_id"],
              "reference": { "columns": ["id"] }
            },
            "cells": ["9"]
          }
        ]
      },
      {
        "description": "a null reference is not checked",
        "comment": "The spec is silent on null foreign key values; proposed: like SQL and Data Package, a null references nothing",
        "data": { "tree.csv": "id,parent_id\n1,\n2,1\n" },
        "valid": true
      }
    ]
  }
]
