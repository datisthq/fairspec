[
  {
    "description": "an integer column referencing a number column",
    "comment": "Integer, Number and Decimal columns compare by numeric value",
    "specification": ["https://fairspec.org/specs/table-schema/#foreignkeys"],
    "dataset": {
      "resources": [
        {
          "name": "users",
          "data": "users.csv",
          "fileDialect": {
            "format": "csv"
          },
          "tableSchema": {
            "properties": {
              "id": {
                "type": "number"
              }
            }
          }
        },
        {
          "name": "posts",
          "data": "posts.csv",
          "fileDialect": {
            "format": "csv"
          },
          "tableSchema": {
            "properties": {
              "user_id": {
                "type": "integer"
              }
            },
            "foreignKeys": [
              {
                "columns": ["user_id"],
                "reference": {
                  "resource": "users",
                  "columns": ["id"]
                }
              }
            ]
          }
        }
      ]
    },
    "tests": [
      {
        "description": "values equal as numbers resolve",
        "data": {
          "users.csv": "id\n1.0\n2.5\n",
          "posts.csv": "user_id\n1\n"
        },
        "valid": true
      },
      {
        "description": "a value equal to none is a foreignKey error",
        "data": {
          "users.csv": "id\n1.0\n2.5\n",
          "posts.csv": "user_id\n1\n2\n"
        },
        "valid": false,
        "errors": [
          {
            "type": "foreignKey",
            "resourceName": "posts",
            "foreignKey": {
              "columns": ["user_id"],
              "reference": {
                "resource": "users",
                "columns": ["id"]
              }
            },
            "cells": ["2"]
          }
        ]
      }
    ]
  },
