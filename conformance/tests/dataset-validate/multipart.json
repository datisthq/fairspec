[
  {
    "description": "multipart csv records",
    "comment": "the records of a multipart resource are the records of each part in order, each part carrying its own header row; row numbers count records of the whole resource",
    "specification": ["https://fairspec.org/specs/dataset/#data"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.csv", "part2.csv"],
          "fileDialect": { "format": "csv", "headerRows": [1] },
          "tableSchema": {
            "properties": { "id": { "type": "integer" }, "name": { "type": "string" } },
            "primaryKey": ["id"]
          }
        }
      ]
    },
    "tests": [
      {
        "description": "valid parts are valid",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\n2,bob\n" },
        "valid": true
      },
      {
        "description": "a part with only its header row is valid",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\n" },
        "valid": true
      },
      {
        "description": "a bad cell in the second part is numbered across parts",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\nx,bob\n" },
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "resourceName": "people",
            "columnName": "id",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "x"
          }
        ]
      },
      {
        "description": "a key repeated across parts is a row/primaryKey error",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\n1,bob\n" },
        "valid": false,
        "errors": [
          {
            "type": "row/primaryKey",
            "resourceName": "people",
            "rowNumber": 2,
            "columnNames": ["id"]
          }
        ]
      }
    ]
  },
  {
    "description": "multipart sha256 integrity",
    "comment": "the hash of id,name\\n1,alice\\n followed by id,name\\n2,bob\\n",
    "specification": ["https://fairspec.org/specs/dataset/#integrity"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.csv", "part2.csv"],
          "integrity": {
            "type": "sha256",
            "hash": "06bd3d00621d6422d6807efc6e5c2a5a72f94f5d0481b300be805b195cf2105f"
          }
        }
      ]
    },
    "tests": [
      {
        "description": "the concatenation of the parts in order is valid",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\n2,bob\n" },
        "valid": true
      },
      {
        "description": "swapped parts are a file/integrity error",
        "data": { "part1.csv": "id,name\n2,bob\n", "part2.csv": "id,name\n1,alice\n" },
        "valid": false,
        "errors": [
          {
            "type": "file/integrity",
            "resourceName": "people",
            "hashType": "sha256",
            "expectedHash": "06bd3d00621d6422d6807efc6e5c2a5a72f94f5d0481b300be805b195cf2105f",
            "actualHash": "dec2c6fa712fbd61e72c773b583809f3ed45dd257db11be6bb64d901743bbda8"
          }
        ]
      },
      {
        "description": "the hash of the first part alone does not cover the resource",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "" },
        "valid": false,
        "errors": [
          {
            "type": "file/integrity",
            "resourceName": "people",
            "hashType": "sha256",
            "expectedHash": "06bd3d00621d6422d6807efc6e5c2a5a72f94f5d0481b300be805b195cf2105f",
            "actualHash": "2b19eb0a580a952891021da1cb7fcca130eadd486130eb565605fc655b6a350b"
          }
        ]
      }
    ]
  },
  {
    "description": "multipart md5 integrity",
    "specification": ["https://fairspec.org/specs/dataset/#integrity"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.csv", "part2.csv"],
          "integrity": { "type": "md5", "hash": "2fcee919838eb41afd5b2047d79b0b62" }
        }
      ]
    },
    "tests": [
      {
        "description": "the concatenation of the parts in order is valid",
        "data": { "part1.csv": "id,name\n1,alice\n", "part2.csv": "id,name\n2,bob\n" },
        "valid": true
      },
      {
        "description": "swapped parts are a file/integrity error",
        "data": { "part1.csv": "id,name\n2,bob\n", "part2.csv": "id,name\n1,alice\n" },
        "valid": false,
        "errors": [
          {
            "type": "file/integrity",
            "resourceName": "people",
            "hashType": "md5",
            "expectedHash": "2fcee919838eb41afd5b2047d79b0b62",
            "actualHash": "bcad3e7ab87608883b66e2bac1a71c32"
          }
        ]
      }
    ]
  },
  {
    "description": "multipart textual",
    "comment": "textual requires utf-8, and the content of a multipart resource is every part, so a non-utf-8 part anywhere fails it",
    "specification": [
      "https://fairspec.org/specs/dataset/#textual",
      "https://fairspec.org/specs/dataset/#data"
    ],
    "dataset": {
      "resources": [
        { "name": "notes", "data": ["part1.txt", "part2.txt"], "textual": true }
      ]
    },
    "tests": [
      {
        "description": "utf-8 parts are valid",
        "data": { "part1.txt": "Hello\n", "part2.txt": "中文\n" },
        "valid": true
      },
      {
        "description": "a latin-1 first part is a file/textual error",
        "data": {
          "part1.txt": { "base64": "Q2Fm6SBy6XN1bekgbmHvdmUg4CBQYXJpcy4=" },
          "part2.txt": "Hello\n"
        },
        "valid": false,
        "errors": [{ "type": "file/textual", "resourceName": "notes" }]
      },
      {
        "description": "a latin-1 second part is a file/textual error",
        "data": {
          "part1.txt": "Hello\n",
          "part2.txt": { "base64": "Q2Fm6SBy6XN1bekgbmHvdmUg4CBQYXJpcy4=" }
        },
        "valid": false,
        "errors": [{ "type": "file/textual", "resourceName": "notes" }]
      }
    ]
  },
  {
    "description": "multipart csv parts with different line endings",
    "comment": "A \\r directly before the default \\n terminator is not part of the row, so a crlf part and an lf part read the same",
    "specification": [
      "https://fairspec.org/specs/dataset/#data",
      "https://fairspec.org/specs/file-dialect/#lineterminator"
    ],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.csv", "part2.csv"],
          "fileDialect": { "format": "csv" },
          "tableSchema": {
            "properties": { "id": { "type": "integer" }, "n": { "type": "integer" } }
          }
        }
      ]
    },
    "tests": [
      {
        "description": "a crlf part and an lf part are valid",
        "data": { "part1.csv": "id,n\r\n1,1\r\n", "part2.csv": "id,n\n2,2\n" },
        "valid": true
      },
      {
        "description": "a bad last cell of a crlf part is reported without the \\r",
        "data": { "part1.csv": "id,n\r\n1,x\r\n", "part2.csv": "id,n\n2,2\n" },
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "resourceName": "people",
            "columnName": "n",
            "columnType": "integer",
            "rowNumber": 1,
            "cell": "x"
          }
        ]
      },
      {
        "description": "a bad cell of the lf part after a crlf part is numbered across parts",
        "data": { "part1.csv": "id,n\r\n1,1\r\n", "part2.csv": "id,n\n2,x\n" },
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "resourceName": "people",
            "columnName": "n",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "x"
          }
        ]
      }
    ]
  },
  {
    "description": "multipart integrity over parts with different line endings",
    "comment": "The hash of id\\r\\n1\\r\\n followed by id\\n2\\n: integrity covers bytes, not records",
    "specification": ["https://fairspec.org/specs/dataset/#integrity"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.csv", "part2.csv"],
          "integrity": {
            "type": "sha256",
            "hash": "45d8feaf92b931c1f45306bb00e73ff5bd293fd71a3ac0b7daa4f2ff3aa847a1"
          }
        }
      ]
    },
    "tests": [
      {
        "description": "the exact bytes are valid",
        "data": { "part1.csv": "id\r\n1\r\n", "part2.csv": "id\n2\n" },
        "valid": true
      },
      {
        "description": "the same records with lf endings are a file/integrity error",
        "data": { "part1.csv": "id\n1\n", "part2.csv": "id\n2\n" },
        "valid": false,
        "errors": [
          {
            "type": "file/integrity",
            "resourceName": "people",
            "hashType": "sha256",
            "expectedHash": "45d8feaf92b931c1f45306bb00e73ff5bd293fd71a3ac0b7daa4f2ff3aa847a1",
            "actualHash": "325e33d1906ba8bdfdd19fc5debc598064ab99698b8266d5028f7d7d2e73b8f5"
          }
        ]
      }
    ]
  },
  {
    "description": "multipart integrity with an empty part",
    "comment": "The hash of id\\n1\\n: a 0-byte part adds no bytes to the concatenation, wherever it sits",
    "specification": ["https://fairspec.org/specs/dataset/#integrity"],
    "dataset": {
      "resources": [
        {
          "name": "people",
          "data": ["part1.txt", "part2.txt"],
          "integrity": {
            "type": "sha256",
            "hash": "7cde7fb64fd82bd152710cf238e017b9ab46c0592483edc067ba4f6c75fac108"
          }
        }
      ]
    },
    "tests": [
      {
        "description": "an empty second part is valid",
        "data": { "part1.txt": "id\n1\n", "part2.txt": "" },
        "valid": true
      },
      {
        "description": "an empty first part is valid",
        "data": { "part1.txt": "", "part2.txt": "id\n1\n" },
        "valid": true
      }
    ]
  },
