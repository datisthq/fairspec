[
  {
    "description": "a resource error and a foreign key violation",
    "comment": "The resource's own errors come first, then the dataset-level foreign key errors. The cell error sits in a column no foreign key reads",
    "specification": [
      "https://fairspec.org/specs/dataset/#validation",
      "https://fairspec.org/specs/table-schema/#validation"
    ],
    "dataset": {
      "resources": [
        {
          "name": "users",
          "data": "users.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": {
            "properties": { "id": { "type": "integer" }, "age": { "type": "integer" } }
          }
        },
        {
          "name": "posts",
          "data": "posts.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": {
            "properties": {
              "user_id": { "type": "integer" },
              "views": { "type": "integer" }
            },
            "foreignKeys": [
              {
                "columns": ["user_id"],
                "reference": { "resource": "users", "columns": ["id"] }
              }
            ]
          }
        }
      ]
    },
    "tests": [
      {
        "description": "the foreign key error follows the cell error",
        "data": {
          "users.csv": "id,age\n1,5\n",
          "posts.csv": "user_id,views\n2,1\n1,y\n"
        },
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "resourceName": "posts",
            "columnName": "views",
            "columnType": "integer",
            "rowNumber": 2,
            "cell": "y"
          },
          {
            "type": "foreignKey",
            "resourceName": "posts",
            "foreignKey": {
              "columns": ["user_id"],
              "reference": { "resource": "users", "columns": ["id"] }
            },
            "cells": ["2"]
          }
        ]
      }
    ]
  },
  {
    "description": "a resource error and a foreign key to a missing resource",
    "specification": ["https://fairspec.org/specs/dataset/#validation"],
    "dataset": {
      "resources": [
        {
          "name": "posts",
          "data": "posts.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": {
            "properties": {
              "user_id": { "type": "integer" },
              "views": { "type": "integer" }
            },
            "foreignKeys": [
              {
                "columns": ["user_id"],
                "reference": { "resource": "users", "columns": ["id"] }
              }
            ]
          }
        }
      ]
    },
    "tests": [
      {
        "description": "the resource error comes first",
        "data": { "posts.csv": "user_id,views\n1,y\n" },
        "valid": false,
        "errors": [
          {
            "type": "cell/type",
            "resourceName": "posts",
            "columnName": "views",
            "columnType": "integer",
            "rowNumber": 1,
            "cell": "y"
          },
          {
            "type": "resource/missing",
            "resourceName": "users",
            "referencingResourceName": "posts"
          }
        ]
      }
    ]
  },
  {
    "description": "a cell error in one resource and an invalid name in another",
    "comment": "A descriptor with metadata errors is not checked against its data",
    "specification": ["https://fairspec.org/specs/dataset/#validation"],
    "dataset": {
      "resources": [
        {
          "name": "users",
          "data": "users.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": { "properties": { "id": { "type": "integer" } } }
        },
        { "name": "my-posts", "data": "posts.csv", "fileDialect": { "format": "csv" } }
      ]
    },
    "tests": [
      {
        "description": "only the metadata error is reported",
        "data": { "users.csv": "id\nx\n", "posts.csv": "id\n1\n" },
        "valid": false,
        "errors": [{ "type": "metadata", "jsonPointer": "/resources/1/name" }]
      }
    ]
  },
  {
    "description": "an uppercase hash on a resource with a bad cell",
    "specification": [
      "https://fairspec.org/specs/dataset/#validation",
      "https://fairspec.org/specs/dataset/#integrity"
    ],
    "dataset": {
      "resources": [
        {
          "name": "users",
          "data": "users.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": { "properties": { "id": { "type": "integer" } } },
          "integrity": { "type": "md5", "hash": "D41D8CD98F00B204E9800998ECF8427E" }
        }
      ]
    },
    "tests": [
      {
        "description": "only the metadata error is reported",
        "data": { "users.csv": "id\nx\n" },
        "valid": false,
        "errors": [{ "type": "metadata", "jsonPointer": "/resources/0/integrity/hash" }]
      }
    ]
  },
  {
    "description": "an invalid file dialect on one resource and a bad cell in another",
    "specification": ["https://fairspec.org/specs/dataset/#validation"],
    "dataset": {
      "resources": [
        {
          "name": "users",
          "data": "users.csv",
          "fileDialect": { "format": "csv" },
          "tableSchema": { "properties": { "id": { "type": "integer" } } }
        },
        {
          "name": "posts",
          "data": "posts.csv",
          "fileDialect": { "format": "csv", "headerRows": [1], "commentRows": [1] }
        }
      ]
    },
    "tests": [
      {
        "description": "only the metadata error is reported",
        "data": { "users.csv": "id\nx\n", "posts.csv": "id\n1\n" },
        "valid": false,
        "errors": [
          { "type": "metadata", "jsonPointer": "/resources/1/fileDialect/commentRows" }
        ]
      }
    ]
  }
]
