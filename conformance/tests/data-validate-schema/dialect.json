[
  {
    "description": "a data schema declaring the JSON Schema 2020-12 dialect",
    "specification": ["https://fairspec.org/specs/data-schema/#profile"],
    "tests": [
      {
        "description": "a valid schema is valid",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": { "name": { "type": "string" } }
        },
        "valid": true
      },
      {
        "description": "an invalid keyword value is a metadata error",
        "data": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": "name"
        },
        "valid": false,
        "errors": [{ "type": "metadata", "jsonPointer": "/required" }]
      }
    ]
  },
  {
    "description": "a data schema without $schema",
    "specification": ["https://fairspec.org/specs/data-schema/#profile"],
    "tests": [
      {
        "description": "a valid schema is valid",
        "data": { "type": "object", "properties": { "name": { "type": "string" } } },
        "valid": true
      }
    ]
  },
  {
    "description": "a data schema declaring another JSON Schema dialect",
    "comment": "Every Data Schema is the 2020-12 dialect",
    "specification": ["https://fairspec.org/specs/data-schema/#profile"],
    "tests": [
      {
        "description": "draft-07 is a metadata error at $schema",
        "data": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object"
        },
        "valid": false,
        "errors": [{ "type": "metadata", "jsonPointer": "/$schema" }]
      },
      {
        "description": "2019-09 is a metadata error at $schema",
        "data": {
          "$schema": "https://json-schema.org/draft/2019-09/schema",
          "type": "object"
        },
        "valid": false,
        "errors": [{ "type": "metadata", "jsonPointer": "/$schema" }]
      },
      {
        "description": "a made-up dialect is a metadata error at $schema",
        "data": { "$schema": "https://example.com/my-dialect", "type": "object" },
        "valid": false,
        "errors": [{ "type": "metadata", "jsonPointer": "/$schema" }]
      }
    ]
  }
]
