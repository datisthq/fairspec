{
  "$schema": "https://json.schemastore.org/tsconfig",

  "include": [
    "${configDir}/*.ts",
    "${configDir}/.scripts/**/*.ts",
    "${configDir}/.livemark/**/*.ts",
    "${configDir}/.livemark/**/*.tsx"
  ],
  "exclude": [
    "${configDir}/**/build/",
    "${configDir}/.livemark/build/",
    "${configDir}/.livemark/.target/",
    "${configDir}/node_modules"
  ],

  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ESNext", "DOM"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "rewriteRelativeImportExtensions": true
  }
}
